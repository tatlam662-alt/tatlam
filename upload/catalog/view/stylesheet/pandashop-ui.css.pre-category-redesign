/* ==========================================================================
   PanDaShop - Specialty Tech Store Theme
   Style: Specialty Tech Store, Dark Neon, Creator and Gaming
   Colors: Midnight Black and Neon Cyan
   Typography: Local system stack with display fallbacks
   ========================================================================== */

/* 2. CSS Custom Properties / Design Tokens */
:root {
  /* Dark neon palette: edit these tokens to retheme the storefront. */
  --pd-navy-dark: #05070D;
  --pd-navy-surface: #0B0F1A;
  --pd-navy-light: #94A3B8;
  --pd-blue-electric: #2EE7FF;
  --pd-blue-hover: #22D3EE;
  --pd-blue-light: #111827;
  --pd-blue-border: #1E293B;
  --pd-cyan-accent: #2EE7FF;

  /* Neutrals */
  --pd-white: #FFFFFF;
  --pd-gray-bg: #05070D;
  --pd-gray-card: #0B0F1A;
  --pd-gray-border: #1E293B;
  --pd-gray-divider: #1E293B;
  --pd-text-main: #F1F5F9;
  --pd-text-muted: #94A3B8;
  --pd-text-light: #64748B;

  /* Function / Utility */
  --pd-sale-red: #FF4D6D;
  --pd-sale-light: #26111B;
  --pd-success-green: #34D399;
  --pd-warning-amber: #FBBF24;

  /* Typography */
  --pd-font: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --pd-font-display: 'Rajdhani', 'Chakra Petch', 'Arial Narrow', sans-serif;
  --pd-primary: var(--pd-blue-electric);
  --pd-primary-dark: var(--pd-blue-hover);
  --pd-primary-light: var(--pd-blue-light);
  --pd-page-bg: var(--pd-gray-bg);
  --pd-text-primary: var(--pd-text-main);
  --pd-text-secondary: var(--pd-text-muted);
  --pd-border-color: var(--pd-gray-border);
  --pd-radius-card: 12px;
  --pd-radius-button: 8px;
  --pd-container-width: 1280px;
  --pd-font-size-base: 0.9375rem; /* 15px */

  /* Shapes & Radii */
  --pd-radius-xs: 4px;
  --pd-radius-sm: 6px;
  --pd-radius-md: 8px;
  --pd-radius-lg: 12px;
  --pd-radius-xl: 16px;
  --pd-radius-2xl: 20px;
  --pd-radius-full: 9999px;

  /* Modern Crisp Elevations & Shadows */
  --pd-shadow-xs: 0 1px 2px 0 rgba(15, 23, 42, 0.05);
  --pd-shadow-sm: 0 2px 4px -1px rgba(15, 23, 42, 0.06);
  --pd-shadow-md: 0 6px 12px -2px rgba(15, 23, 42, 0.08), 0 3px 6px -3px rgba(15, 23, 42, 0.04);
  --pd-shadow-lg: 0 12px 24px -4px rgba(15, 23, 42, 0.08), 0 4px 8px -2px rgba(15, 23, 42, 0.03);
  --pd-shadow-glow: 0 10px 25px -5px rgba(46, 231, 255, 0.22), 0 8px 10px -6px rgba(46, 231, 255, 0.12);

  /* Transitions */
  --pd-transition-fast: all 0.15s ease-in-out;
  --pd-transition-normal: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 3. Base Reset & Global Styles */
html {
  font-size: 16px;
  box-sizing: border-box;
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
}

*, *::before, *::after {
  box-sizing: inherit;
}

body {
  font-family: var(--pd-font) !important;
  font-size: var(--pd-font-size-base);
  color: var(--pd-text-main);
  background-color: var(--pd-gray-bg);
  line-height: 1.6;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
}

/* Headings */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--pd-font);
  font-weight: 600;
  color: var(--pd-navy-dark);
  margin-top: 0;
  text-transform: none;
  letter-spacing: -0.015em;
}

h1 { font-size: 1.75rem; font-weight: 700; }
h2 { font-size: 1.375rem; font-weight: 700; }
h3 { font-size: 1.125rem; font-weight: 600; }
h4 { font-size: 1rem; font-weight: 600; }
h5 { font-size: 0.875rem; font-weight: 600; }

a {
  color: var(--pd-text-main);
  text-decoration: none;
  transition: var(--pd-transition-fast);
}

a:hover {
  color: var(--pd-blue-electric);
}

/* Accessibility & Focus States */
:focus-visible {
  outline: 2px solid var(--pd-blue-electric);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* 4. TOP NOTIFICATION BAR */
.pd-topbar {
  background-color: var(--pd-navy-dark);
  color: #94A3B8;
  font-size: 0.8125rem;
  padding: 7px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.pd-topbar a {
  color: #CBD5E1;
}

.pd-topbar a:hover {
  color: var(--pd-cyan-accent);
}

.pd-topbar-notice {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 500;
}

.pd-topbar-notice i {
  color: var(--pd-cyan-accent);
}

.pd-topbar-links {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16px;
  list-style: none;
  margin: 0;
  padding: 0;
}

/* 5. MAIN HEADER (Sticky on Desktop) */
.pd-header {
  background-color: var(--pd-white);
  border-bottom: 1px solid var(--pd-gray-border);
  position: sticky;
  top: 0;
  z-index: 1020;
  box-shadow: var(--pd-shadow-xs);
  transition: var(--pd-transition-normal);
}

/* Logo */
.pd-logo {
  display: flex;
  align-items: center;
  text-decoration: none;
  font-weight: 800;
  font-size: 1.5rem;
  color: var(--pd-navy-dark);
  letter-spacing: -0.03em;
  white-space: nowrap;
}

.pd-logo-icon {
  width: 36px;
  height: 36px;
  background: linear-gradient(135deg, var(--pd-navy-dark) 0%, var(--pd-blue-electric) 100%);
  color: var(--pd-white);
  border-radius: var(--pd-radius-md);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
  font-size: 1.25rem;
  box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
}

.pd-logo-highlight {
  color: var(--pd-blue-electric);
}

/* Modern Large Search Bar */
.pd-search-box {
  flex: 1;
  max-width: 580px;
  position: relative;
}

.pd-search-autocomplete {
  position: relative;
  width: 100%;
}

.pd-search-suggestions {
  position: absolute;
  z-index: 1080;
  top: calc(100% + 8px);
  left: 0;
  right: 0;
  max-height: min(70vh, 440px);
  overflow-y: auto;
  padding: 6px;
  margin: 0;
  list-style: none;
  background: var(--pd-white);
  border: 1px solid var(--pd-gray-border);
  border-radius: var(--pd-radius-lg);
  box-shadow: var(--pd-shadow-lg);
}

.pd-search-suggestions[hidden] { display: none; }

.pd-search-suggestion {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 9px 10px;
  border: 0;
  border-radius: var(--pd-radius-md);
  color: var(--pd-text-main);
  background: transparent;
  text-align: left;
  cursor: pointer;
}

.pd-search-suggestion:hover,
.pd-search-suggestion[aria-selected="true"] { background: var(--pd-blue-light); }

.pd-search-suggestion img {
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  object-fit: contain;
  border-radius: var(--pd-radius-sm);
  background: var(--pd-gray-bg);
}

.pd-search-suggestion-copy { min-width: 0; display: grid; gap: 2px; }
.pd-search-suggestion-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
.pd-search-suggestion-price { color: var(--pd-blue-electric); font-weight: 700; font-size: .875rem; }
.pd-search-suggestion-status { padding: 10px 12px; color: var(--pd-text-muted); font-size: .875rem; }

.pd-search-form {
  display: flex;
  align-items: center;
  background: var(--pd-gray-bg);
  border: 1.5px solid var(--pd-gray-border);
  border-radius: var(--pd-radius-full);
  padding: 3px 4px 3px 18px;
  transition: var(--pd-transition-fast);
}

.pd-search-form:focus-within {
  background: var(--pd-white);
  border-color: var(--pd-blue-electric);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
}

.pd-search-input {
  flex: 1;
  border: none;
  background: transparent;
  font-family: var(--pd-font);
  font-size: 0.9375rem;
  color: var(--pd-text-main);
  outline: none;
  padding: 7px 8px;
}

.pd-search-input::placeholder {
  color: var(--pd-text-muted);
}

.pd-search-btn {
  background: linear-gradient(135deg, var(--pd-blue-electric) 0%, var(--pd-blue-hover) 100%);
  color: var(--pd-white);
  border: none;
  border-radius: var(--pd-radius-full);
  width: 38px;
  height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: var(--pd-transition-fast);
  box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3);
}

.pd-search-btn:hover {
  background: var(--pd-navy-dark);
  color: var(--pd-white);
}

/* Header Action Buttons */
.pd-header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.pd-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: var(--pd-radius-md);
  color: var(--pd-navy-dark);
  font-weight: 500;
  font-size: 0.875rem;
  position: relative;
  transition: var(--pd-transition-fast);
  background: transparent;
  border: none;
  cursor: pointer;
}

.pd-action-btn:hover {
  background: var(--pd-blue-light);
  color: var(--pd-blue-electric);
}

.pd-cart-btn {
  background: var(--pd-navy-dark);
  color: var(--pd-white);
  border-radius: var(--pd-radius-full);
  padding: 8px 16px;
  transition: var(--pd-transition-fast);
}

.pd-cart-btn:hover {
  background: var(--pd-blue-electric);
  color: var(--pd-white);
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
}

.pd-cart-btn .pd-badge {
  background: var(--pd-blue-electric);
  color: var(--pd-white);
}

/* 6. NAVIGATION BAR & MEGA MENU */
#menu,
nav#menu,
.pd-navbar-container #menu {
  background: var(--pd-white) !important;
  background-image: none !important;
  border: none !important;
  border-radius: 0 !important;
  min-height: auto !important;
  margin-bottom: 0 !important;
  box-shadow: none !important;
  padding: 0 !important;
}

.pd-navbar-container {
  background: var(--pd-white);
  border-bottom: 1px solid var(--pd-gray-border);
}

.pd-navbar {
  display: flex;
  align-items: center;
  padding: 0;
  position: relative;
}

.pd-nav-list {
  display: flex;
  align-items: center;
  list-style: none;
  margin: 0;
  padding: 0;
  gap: 4px;
}

.pd-nav-item {
  position: relative;
}

#menu .navbar-nav > li > a,
#menu .nav-link,
#menu a,
.pd-nav-link {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 16px !important;
  font-size: 0.9375rem;
  font-weight: 500 !important;
  color: var(--pd-navy-dark) !important;
  border-radius: var(--pd-radius-sm);
  text-shadow: none !important;
  transition: var(--pd-transition-fast);
}

#menu .navbar-nav > li > a:hover,
#menu .nav-link:hover,
#menu a:hover,
.pd-nav-link:hover {
  color: var(--pd-blue-electric) !important;
  background-color: var(--pd-blue-light) !important;
}

/* Mega Dropdown */
.pd-mega-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  background: var(--pd-white);
  border: 1px solid var(--pd-gray-border);
  border-radius: var(--pd-radius-lg);
  box-shadow: 0 16px 32px -4px rgba(15, 23, 42, 0.12);
  min-width: 680px;
  padding: 22px;
  display: none;
  z-index: 1030;
}

.pd-nav-item:hover .pd-mega-dropdown {
  display: block;
}

.pd-mega-columns {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 20px;
}

.pd-mega-col-title {
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--pd-navy-dark);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 10px;
  padding-bottom: 6px;
  border-bottom: 2px solid var(--pd-blue-electric);
  display: inline-block;
}

.pd-mega-sublist {
  list-style: none;
  padding: 0;
  margin: 0;
}

.pd-mega-sublist li {
  margin-bottom: 6px;
}

.pd-mega-sublist a {
  font-size: 0.875rem;
  color: var(--pd-text-muted);
  display: block;
  padding: 4px 0;
}

.pd-mega-sublist a:hover {
  color: var(--pd-blue-electric);
  padding-left: 4px;
}

/* 7. MODERN TECH PRODUCT CARD (THUMB.TWIG) */
.pd-product-card {
  background: var(--pd-white);
  border: 1px solid var(--pd-gray-border);
  border-radius: var(--pd-radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  height: 100%;
  position: relative;
  transition: var(--pd-transition-normal);
}

.pd-product-card:hover {
  border-color: var(--pd-blue-border);
  box-shadow: var(--pd-shadow-glow);
  transform: translateY(-3px);
}

/* Card Image */
.pd-card-image-wrap {
  position: relative;
  width: 100%;
  padding-top: 100%; /* 1:1 Aspect Ratio */
  background: var(--pd-gray-bg);
  overflow: hidden;
}

.pd-card-image-wrap img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 16px;
  transition: transform 0.35s ease;
}

.pd-product-card:hover .pd-card-image-wrap img {
  transform: scale(1.06);
}

/* Badges */
.pd-card-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: var(--pd-sale-red);
  color: var(--pd-white);
  font-size: 0.75rem;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: var(--pd-radius-sm);
  z-index: 2;
  box-shadow: 0 2px 4px rgba(239, 68, 68, 0.25);
}

/* Quick Action Buttons (Wishlist / Compare) */
.pd-card-quick-actions {
  position: absolute;
  top: 10px;
  right: 10px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  z-index: 2;
  opacity: 0.85;
  transition: var(--pd-transition-fast);
}

.pd-quick-action-form,
.pd-cart-action-form {
  margin: 0;
}

.pd-product-card:hover .pd-card-quick-actions {
  opacity: 1;
}

.pd-btn-icon-action {
  width: 32px;
  height: 32px;
  border-radius: var(--pd-radius-full);
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(4px);
  border: 1px solid var(--pd-gray-border);
  color: var(--pd-text-muted);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8125rem;
  cursor: pointer;
  transition: var(--pd-transition-fast);
}

.pd-btn-icon-action:hover {
  background: var(--pd-navy-dark);
  color: var(--pd-white);
  border-color: var(--pd-navy-dark);
}

/* Card Body */
.pd-card-body {
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.pd-card-title {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--pd-navy-dark);
  margin-bottom: 8px;
  line-height: 1.4;
  height: 2.8em; /* Exactly 2 lines */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pd-card-title a {
  color: inherit;
}

.pd-card-title a:hover {
  color: var(--pd-blue-electric);
}

/* Price */
.pd-card-price-wrap {
  margin-top: auto;
  margin-bottom: 12px;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6px;
}

.pd-price-current {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--pd-blue-electric);
}

.pd-price-current.has-sale {
  color: var(--pd-sale-red);
}

.pd-price-old {
  font-size: 0.8125rem;
  color: var(--pd-text-muted);
  text-decoration: line-through;
}

/* Add to Cart CTA */
.pd-btn-add-cart {
  width: 100%;
  background: var(--pd-gray-bg);
  color: var(--pd-navy-dark);
  border: 1px solid var(--pd-gray-border);
  border-radius: var(--pd-radius-md);
  padding: 8px 12px;
  font-size: 0.875rem;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  transition: var(--pd-transition-fast);
}

.pd-btn-add-cart:hover {
  background: var(--pd-blue-electric);
  border-color: var(--pd-blue-electric);
  color: var(--pd-white);
  box-shadow: 0 4px 10px rgba(37, 99, 235, 0.25);
}

/* 8. HOME PAGE SECTIONS */

/* Cart and checkout */
.pd-cart-panel {
  border-color: var(--pd-gray-border) !important;
  border-radius: var(--pd-radius-lg) !important;
  box-shadow: var(--pd-shadow-sm) !important;
}

.pd-cart-panel .table {
  min-width: 680px;
}

.pd-cart-panel .table thead th {
  color: var(--pd-navy-dark);
  font-size: 0.8125rem;
  font-weight: 700;
  white-space: nowrap;
}

.pd-cart-panel .table td {
  border-color: var(--pd-gray-divider);
}

.pd-checkout-page {
  padding-top: 1rem;
  padding-bottom: 2rem;
}

.pd-checkout-layout > .col-lg,
.pd-checkout-layout > .col-lg-7 {
  min-width: 0;
}

.pd-checkout-page fieldset {
  padding: 1rem;
  margin-bottom: 1rem;
  background: var(--pd-white);
  border: 1px solid var(--pd-gray-border);
  border-radius: var(--pd-radius-lg);
}

.pd-checkout-page fieldset legend {
  float: none;
  width: auto;
  padding: 0 0.35rem;
  margin: 0 0 0.75rem -0.35rem;
  color: var(--pd-navy-dark);
  font-size: 1rem;
  font-weight: 700;
}

.pd-checkout-page #checkout-confirm .table {
  background: var(--pd-white);
  border: 1px solid var(--pd-gray-border);
  border-radius: var(--pd-radius-lg);
  overflow: hidden;
}

.pd-checkout-page #checkout-confirm .table > :not(caption) > * > * {
  padding: 0.75rem;
  border-color: var(--pd-gray-divider);
}

.pd-checkout-page #button-confirm {
  min-height: 46px;
  padding: 0.7rem 1.5rem;
  border-radius: var(--pd-radius-md);
  font-weight: 700;
}

/* Section Titles */
.pd-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  padding-bottom: 10px;
  border-bottom: 1.5px solid var(--pd-gray-border);
}

.pd-section-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--pd-navy-dark);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 10px;
}

.pd-section-title::before {
  content: '';
  display: inline-block;
  width: 4px;
  height: 20px;
  background: var(--pd-blue-electric);
  border-radius: var(--pd-radius-xs);
}

/* Quick Tech Categories Grid (8 items) */
.pd-quick-categories {
  padding: 10px 0 20px;
}

.pd-category-grid-8 {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 12px;
}

.pd-category-tile {
  background: var(--pd-white);
  border: 1px solid var(--pd-gray-border);
  border-radius: var(--pd-radius-lg);
  padding: 16px 8px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  transition: var(--pd-transition-normal);
}

.pd-category-tile:hover {
  border-color: var(--pd-blue-border);
  transform: translateY(-2px);
  box-shadow: var(--pd-shadow-glow);
}

.pd-category-icon {
  width: 46px;
  height: 46px;
  background: var(--pd-blue-light);
  color: var(--pd-blue-electric);
  border-radius: var(--pd-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  transition: var(--pd-transition-fast);
}

.pd-category-tile:hover .pd-category-icon {
  background: var(--pd-blue-electric);
  color: var(--pd-white);
}

.pd-category-name {
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--pd-navy-dark);
}

/* Promo / Special Deals Block */
.pd-deal-banner {
  background: linear-gradient(135deg, var(--pd-navy-dark) 0%, var(--pd-navy-surface) 100%);
  border-radius: var(--pd-radius-xl);
  padding: 28px 32px;
  color: var(--pd-white);
  margin: 28px 0;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: var(--pd-shadow-md);
}

.pd-deal-badge {
  background: rgba(239, 68, 68, 0.2);
  color: #F87171;
  border: 1px solid rgba(239, 68, 68, 0.3);
  font-size: 0.75rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: var(--pd-radius-full);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 10px;
}

/* Trust Badges Section (5 items) */
.pd-trust-section {
  padding: 24px 0;
  margin: 32px 0;
  background: var(--pd-white);
  border: 1px solid var(--pd-gray-border);
  border-radius: var(--pd-radius-xl);
}

.pd-trust-grid-5 {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16px;
  padding: 0 16px;
}

.pd-trust-item {
  display: flex;
  align-items: center;
  gap: 12px;
}

.pd-trust-icon {
  width: 44px;
  height: 44px;
  min-width: 44px;
  background: var(--pd-blue-light);
  color: var(--pd-blue-electric);
  border-radius: var(--pd-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
}

.pd-trust-title {
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--pd-navy-dark);
  margin-bottom: 2px;
}

.pd-trust-desc {
  font-size: 0.75rem;
  color: var(--pd-text-muted);
  margin: 0;
}

/* 9. PRODUCT DETAIL PAGE */
.pd-product-detail-wrap {
  background: var(--pd-white);
  border: 1px solid var(--pd-gray-border);
  border-radius: var(--pd-radius-xl);
  padding: 24px;
  margin-bottom: 24px;
}

.pd-gallery-main {
  background: var(--pd-gray-bg);
  border: 1px solid var(--pd-gray-border);
  border-radius: var(--pd-radius-lg);
  padding: 20px;
  text-align: center;
  margin-bottom: 12px;
}

.pd-gallery-main img {
  max-height: 420px;
  object-fit: contain;
}

.pd-gallery-thumbs {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.pd-gallery-thumb-item {
  width: 72px;
  height: 72px;
  border: 1.5px solid var(--pd-gray-border);
  border-radius: var(--pd-radius-md);
  padding: 4px;
  background: var(--pd-white);
  cursor: pointer;
  transition: var(--pd-transition-fast);
}

.pd-gallery-thumb-item:hover,
.pd-gallery-thumb-item.active {
  border-color: var(--pd-blue-electric);
}

.pd-gallery-thumb-item img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.pd-product-title-large {
  font-size: 1.625rem;
  font-weight: 700;
  color: var(--pd-navy-dark);
  margin-bottom: 12px;
}

.pd-badge-stock {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: var(--pd-radius-full);
  background: #ECFDF5;
  color: var(--pd-success-green);
  font-size: 0.8125rem;
  font-weight: 600;
}

.pd-detail-price-box {
  background: var(--pd-gray-bg);
  border-radius: var(--pd-radius-lg);
  padding: 16px 20px;
  margin-bottom: 20px;
  display: flex;
  align-items: baseline;
  gap: 14px;
}

.pd-detail-price-main {
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--pd-blue-electric);
}

.pd-detail-price-main.sale {
  color: var(--pd-sale-red);
}

.pd-detail-price-old {
  font-size: 1.125rem;
  color: var(--pd-text-muted);
  text-decoration: line-through;
}

/* Option Chips */
.pd-option-chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 6px;
}

.pd-option-chip input[type="radio"],
.pd-option-chip input[type="checkbox"] {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  clip-path: inset(50%);
}

.pd-option-chip:focus-within label {
  outline: 2px solid var(--pd-blue-electric);
  outline-offset: 2px;
}

.pd-option-chip label {
  border: 1.5px solid var(--pd-gray-border);
  background: var(--pd-white);
  padding: 8px 16px;
  border-radius: var(--pd-radius-md);
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--pd-transition-fast);
}

.pd-option-chip input:checked + label {
  border-color: var(--pd-blue-electric);
  background: var(--pd-blue-light);
  color: var(--pd-blue-hover);
  font-weight: 600;
}

.pd-btn-buy-now {
  flex: 1;
  background: linear-gradient(135deg, var(--pd-blue-electric) 0%, var(--pd-blue-hover) 100%);
  color: var(--pd-white);
  border: none;
  border-radius: var(--pd-radius-md);
  padding: 14px 20px;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  text-align: center;
  transition: var(--pd-transition-fast);
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
}

.pd-btn-buy-now:hover {
  background: var(--pd-navy-dark);
  color: var(--pd-white);
}

.pd-btn-add-cart-lg {
  background: var(--pd-navy-dark);
  color: var(--pd-white);
  border: none;
  border-radius: var(--pd-radius-md);
  padding: 14px 24px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: var(--pd-transition-fast);
}

.pd-btn-add-cart-lg:hover {
  background: #1E293B;
  color: var(--pd-white);
}

.pd-detail-guarantees {
  border: 1px dashed var(--pd-blue-border);
  background: var(--pd-blue-light);
  border-radius: var(--pd-radius-lg);
  padding: 16px;
  margin-top: 20px;
}

.pd-detail-guarantees h6 {
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--pd-blue-hover);
  margin-bottom: 10px;
}

.pd-guarantee-list {
  list-style: none;
  padding: 0;
  margin: 0;
  font-size: 0.8125rem;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.pd-guarantee-list li i {
  color: var(--pd-blue-electric);
  margin-right: 6px;
}

/* Tabs */
.pd-nav-tabs {
  border-bottom: 2px solid var(--pd-gray-border);
  gap: 16px;
}

.pd-nav-tabs .nav-link {
  border: none;
  padding: 12px 18px;
  font-weight: 600;
  color: var(--pd-text-muted);
  border-bottom: 2px solid transparent;
  margin-bottom: -2px;
}

.pd-nav-tabs .nav-link.active {
  color: var(--pd-blue-electric);
  border-bottom-color: var(--pd-blue-electric);
  background: transparent;
}

/* Mobile Sticky Buy Bar */
.pd-mobile-sticky-bar {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--pd-white);
  border-top: 1px solid var(--pd-gray-border);
  padding: 10px 16px;
  z-index: 1040;
  box-shadow: 0 -4px 10px rgba(0, 0, 0, 0.08);
  align-items: center;
  justify-content: space-between;
}

/* 10. PREMIUM DARK TECH FOOTER */
.pd-footer {
  background: var(--pd-navy-dark);
  color: #94A3B8;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding: 56px 0 24px;
  margin-top: 56px;
}

.pd-footer h5,
.pd-footer-title {
  font-size: 0.9375rem;
  font-weight: 700;
  color: var(--pd-white);
  margin-bottom: 18px;
}

.pd-footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
}

.pd-footer-links li {
  margin-bottom: 10px;
}

.pd-footer-links a {
  color: #94A3B8;
  font-size: 0.875rem;
}

.pd-footer-links a:hover {
  color: var(--pd-cyan-accent);
}

.pd-footer-bottom {
  margin-top: 40px;
  padding-top: 24px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  font-size: 0.8125rem;
  color: #64748B;
}

.pd-footer-bottom a {
  color: #94A3B8;
}

/* Mobile Drawer (Offcanvas Menu) */
.pd-offcanvas {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  width: 280px;
  background: var(--pd-white);
  z-index: 1050;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  transform: translateX(-100%);
  transition: transform 0.3s ease-in-out;
  overflow-y: auto;
  padding: 20px;
}

.pd-offcanvas.show {
  transform: translateX(0);
}

.pd-offcanvas-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(11, 19, 43, 0.6);
  z-index: 1045;
  display: none;
}

.pd-offcanvas-backdrop.show {
  display: block;
}

/* List-group and Pagination Overrides */
.list-group-item.active {
  background-color: var(--pd-navy-dark) !important;
  border-color: var(--pd-navy-dark) !important;
  color: var(--pd-white) !important;
  font-weight: 600;
}

.list-group-item:hover {
  background-color: var(--pd-blue-light) !important;
  color: var(--pd-blue-electric) !important;
}

.pagination .page-item.active .page-link {
  background-color: var(--pd-blue-electric) !important;
  border-color: var(--pd-blue-electric) !important;
  color: var(--pd-white) !important;
}

.pagination .page-link {
  color: var(--pd-navy-dark);
  border-radius: var(--pd-radius-sm);
  margin: 0 2px;
  border-color: var(--pd-gray-border);
}

.btn-primary {
  background: linear-gradient(135deg, var(--pd-blue-electric) 0%, var(--pd-blue-hover) 100%) !important;
  border-color: var(--pd-blue-electric) !important;
  color: var(--pd-white) !important;
}

.btn-primary:hover {
  background: var(--pd-navy-dark) !important;
  border-color: var(--pd-navy-dark) !important;
}

/* 11. RESPONSIVE BREAKPOINTS */
@media (max-width: 1199.98px) {
  .pd-category-grid-8 {
    grid-template-columns: repeat(4, 1fr);
  }
  .pd-trust-grid-5 {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 991.98px) {
  .pd-navbar-container {
    display: none;
  }

  .pd-mobile-nav-toggle {
    display: inline-flex;
    padding: 6px;
    background: none;
    border: none;
    font-size: 1.25rem;
    color: var(--pd-navy-dark);
  }

  #logo {
    max-width: 140px;
    overflow: hidden;
  }

  #logo img {
    max-width: 100% !important;
    max-height: 28px !important;
    object-fit: contain;
  }

  .pd-header-actions {
    display: flex !important;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .pd-cart-btn {
    width: 36px !important;
    height: 36px !important;
    padding: 0 !important;
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    border-radius: var(--pd-radius-full) !important;
  }

  .pd-category-grid-8 {
    grid-template-columns: repeat(4, 1fr);
  }

  .pd-trust-grid-5 {
    grid-template-columns: repeat(2, 1fr);
  }

  .pd-mobile-sticky-bar {
    display: flex;
  }

  body.has-sticky-bar {
    padding-bottom: 70px;
  }
}

@media (max-width: 575.98px) {
  .pd-topbar {
    display: none;
  }

  .pd-category-grid-8 {
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  .pd-category-tile {
    padding: 10px 4px;
  }

  .pd-category-icon {
    width: 36px;
    height: 36px;
    font-size: 1rem;
  }

  .pd-category-name {
    font-size: 0.6875rem;
  }

  .pd-trust-grid-5 {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .pd-product-card .pd-card-body {
    padding: 10px 12px;
  }

  .pd-price-current {
    font-size: 1rem;
  }

  .pd-btn-add-cart {
    padding: 6px 8px;
    font-size: 0.8125rem;
  }

  .pd-footer {
    padding: 36px 0 20px;
  }
}

/* Dark neon storefront surfaces and OpenCart/Bootstrap component alignment */
