.panda-dock-telegram { background: #229ed9; box-shadow: 0 0 12px rgba(34,158,217,.4); }
.panda-dock-contact { background: #0f172a; border-color: #334155; color: #00e5ff; }
.panda-dock-tooltip { position: absolute; right: 62px; padding: 7px 10px; border: 1px solid #26374d; border-radius: 8px; background: #0f172a; color: #eaf4ff; font-size: 12px; line-height: 1.2; white-space: nowrap; opacity: 0; visibility: hidden; transform: translateX(4px); transition: .16s ease; pointer-events: none; }
.panda-dock-item:hover .panda-dock-tooltip,.panda-dock-item:focus-within .panda-dock-tooltip { opacity: 1; visibility: visible; transform: translateX(0); }
.panda-ai-pulse { position: absolute; top: -2px; right: -2px; width: 12px; height: 12px; border-radius: 50%; background: #00e5ff; box-shadow: 0 0 8px #00e5ff; animation: panda-pulse-ring 1.8s cubic-bezier(.215,.61,.355,1) infinite; }
@keyframes panda-pulse-ring { 0% { transform: scale(.9); opacity: 1; } 50% { transform: scale(1.4); opacity: .4; } 100% { transform: scale(.9); opacity: 1; } }
.panda-ai-modal .modal-content { overflow: hidden; border: 1px solid #26374d; border-radius: 18px; background: #0f172a; color: #f8fafc; box-shadow: 0 24px 70px rgba(0,0,0,.5); }
.panda-ai-modal .modal-header { display: flex; align-items: center; gap: 12px; border-bottom: 1px solid #26374d; background: linear-gradient(135deg,#0f172a,#17283b); }
.panda-ai-avatar { position: relative; display: grid; width: 42px; height: 42px; flex: 0 0 42px; place-items: center; border: 1px solid rgba(0,229,255,.55); border-radius: 50%; background: rgba(0,229,255,.12); color: #00e5ff; }
.panda-ai-avatar span { position: absolute; right: 0; bottom: 1px; width: 10px; height: 10px; border: 2px solid #0f172a; border-radius: 50%; background: #38f2a5; }
.panda-ai-heading { min-width: 0; flex: 1; }
.panda-ai-heading h2 { margin: 0; color: #f8fafc; font-size: 16px; font-weight: 750; }
.panda-ai-heading p { margin: 3px 0 0; color: #9aabc0; font-size: 12px; }
.panda-ai-modal .modal-body { display: flex; height: min(52vh,400px); min-height: 260px; flex-direction: column; gap: 12px; overflow-y: auto; background: #090d16; padding: 18px; }
.panda-ai-message { max-width: 86%; padding: 11px 13px; border: 1px solid #2a3a50; border-radius: 14px; color: #e8eef8; font-size: 14px; line-height: 1.5; overflow-wrap: anywhere; white-space: pre-wrap; }
.panda-ai-message--assistant { align-self: flex-start; background: #172337; }
.panda-ai-message--user { align-self: flex-end; border-color: #00a9c2; background: linear-gradient(135deg,#00d8ee,#00a9e8); color: #06121b; }
.panda-ai-suggestions { display: flex; gap: 8px; overflow-x: auto; padding: 9px 14px; border-top: 1px solid #26374d; background: #0f172a; }
.btn-ai-chip { flex: 0 0 auto; padding: 4px 12px; border: 1px solid #334155; border-radius: 20px; background: #1e293b; color: #00e5ff; font-size: 11px; font-weight: 600; transition: all .2s ease; }
.btn-ai-chip:hover,.btn-ai-chip:focus-visible { border-color: #00e5ff; background: #00e5ff; color: #090d16; box-shadow: 0 0 10px rgba(0,229,255,.4); }
.max-w-85 { max-width: 85% !important; }
.hover-card-ai:hover,.panda-ai-product:hover { border-color: #00e5ff; transform: translateX(3px); box-shadow: 0 0 12px rgba(0,229,255,.2); }
.panda-ai-typing { color: #94a3b8; font-style: italic; }
.panda-ai-product { display: flex; align-items: center; gap: 12px; align-self: flex-start; width: min(100%, 360px); max-width: 100%; color: #e8eef8; text-decoration: none; transition: border-color .2s ease, background-color .2s ease; }
.panda-ai-product:hover,.panda-ai-product:focus-visible { border-color: #00dff5; background: #1c2c42; color: #fff; }
.panda-ai-product img { width: 56px; height: 56px; flex: 0 0 56px; border-radius: 8px; object-fit: contain; background: #fff; }
.panda-ai-product-details { display: grid; min-width: 0; gap: 4px; }
.panda-ai-product-details strong { font-size: 13px; }
.panda-ai-product-details > span { color: #00e5ff; font-size: 13px; font-weight: 700; }
.panda-ai-modal .modal-footer { display: block; border-top: 1px solid #26374d; background: #0f172a; padding: 12px 16px 10px; }
.panda-ai-form { display: flex; gap: 9px; }
.panda-ai-form .form-control { min-width: 0; border-color: #334155; border-radius: 10px; background: #172337; color: #f8fafc; }
.panda-ai-form .form-control:focus { border-color: #00dff5; box-shadow: 0 0 0 3px rgba(0,229,255,.14); }
.panda-ai-form .form-control::placeholder { color: #8291a6; }
.panda-ai-form button { display: grid; width: 44px; flex: 0 0 44px; place-items: center; border: 0; border-radius: 10px; background: #00dff5; color: #07111d; }
.panda-ai-form button:disabled { cursor: wait; opacity: .55; }
.panda-ai-note { margin: 8px 0 0; color: #8190a5; font-size: 11px; }
@media (max-width: 575.98px) { .panda-quick-dock { right: max(12px,env(safe-area-inset-right)); bottom: max(14px,env(safe-area-inset-bottom)); } .panda-dock-icon { width: 46px; height: 46px; } .panda-dock-trigger { width: 54px; height: 54px; } .panda-ai-modal .modal-dialog { margin: 12px; } .panda-ai-modal .modal-body { height: min(55vh,400px); } }
@media (prefers-reduced-motion: reduce) { .panda-dock-icon,.panda-dock-trigger,.panda-dock-tooltip { transition: none; } .panda-ai-pulse { animation: none; } }

/* Keep the contact breadcrumb attached to the page rather than its short nav wrapper. */
#information-contact > nav[aria-label="breadcrumb"] { position: sticky; top: calc(var(--nx-header-h,68px) + 8px); z-index: 1030; margin-bottom: 20px; padding: 0; background: rgba(5,7,13,.96); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
#information-contact > nav[aria-label="breadcrumb"] .breadcrumb { position: static; margin: 0 !important; padding: 10px 0 !important; }
@media (max-width: 991.98px) { #information-contact > nav[aria-label="breadcrumb"] { top: 112px; } }

/* Reveal a compact support hint when the floating dock trigger is targeted. */
.panda-dock-trigger-wrap { position: relative; display: flex; align-items: center; }
.panda-dock-trigger::before { content: none; }
.panda-dock-trigger-tooltip { position: absolute; right: calc(100% + 12px); top: 50%; z-index: 1; padding: 8px 12px; border: 1px solid rgba(0,229,255,.36); border-radius: 10px; background: linear-gradient(135deg,#111c2d,#0b1220); color: #eafaff; font: 700 13px/1.2 var(--pd-font,Arial,sans-serif); letter-spacing: .02em; white-space: nowrap; opacity: 0; visibility: hidden; transform: translate(6px,-50%); transition: opacity .18s ease,transform .18s ease,visibility .18s ease; pointer-events: none; box-shadow: 0 8px 24px rgba(0,0,0,.4),0 0 14px rgba(0,229,255,.12); }
.panda-dock-trigger-tooltip::after { position: absolute; top: 50%; right: -5px; width: 8px; height: 8px; border-top: 1px solid rgba(0,229,255,.36); border-right: 1px solid rgba(0,229,255,.36); background: #0d1727; content: ""; transform: translateY(-50%) rotate(45deg); }
.panda-dock-trigger-wrap:hover .panda-dock-trigger-tooltip,.panda-dock-trigger-wrap:focus-within .panda-dock-trigger-tooltip { opacity: 1; visibility: visible; transform: translate(0,-50%); }
