  --nx-cyan: #2EE7FF;
  --nx-cyan-dim: rgba(46, 231, 255, .15);
  --nx-sale: #F43F5E;
  --nx-ok: #34D399;
  --nx-warn: #FBBF24;
  --nx-radius: 12px;
  --nx-radius-sm: 8px;
