a { color: var(--nx-text); }
a:hover { color: var(--nx-cyan); }
:focus-visible { outline: 2px solid var(--nx-cyan); outline-offset: 3px; }
input[type="text"], input[type="email"], input[type="password"], input[type="tel"], input[type="search"], input[type="number"], select, textarea, .form-control, .form-select {
  color: var(--nx-text); background-color: var(--nx-elevated); border-color: var(--nx-border);
