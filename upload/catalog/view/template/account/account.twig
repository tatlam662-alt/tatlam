{{ header }}
<style>
  #account-account { --member-bg: #0b1220; --member-card: #111b2d; --member-line: #26364d; --member-cyan: #22d3ee; }
  #account-account .member-hero { position: relative; overflow: hidden; padding: clamp(24px, 4vw, 42px); border: 1px solid var(--member-line); border-radius: 20px; background: radial-gradient(circle at 92% 12%, rgba(34,211,238,.18), transparent 30%), linear-gradient(120deg, #111b2d, #0b1220 72%); }
  #account-account .member-hero:after { content: ""; position: absolute; width: 220px; height: 220px; right: -70px; bottom: -145px; border: 1px solid rgba(34,211,238,.25); border-radius: 50%; box-shadow: 0 0 0 22px rgba(34,211,238,.035), 0 0 0 45px rgba(34,211,238,.025); }
  #account-account .member-hero > * { position: relative; z-index: 1; }
  #account-account .panda-breadcrumb { background: rgba(30,41,59,.6) !important; border: 1px solid rgba(255,255,255,.08); backdrop-filter: blur(8px); }
  #account-account .panda-breadcrumb .breadcrumb-item + .breadcrumb-item::before { color: #64748b; }
  #account-account .panda-avatar-circle { display: flex; flex: 0 0 64px; width: 64px; height: 64px; align-items: center; justify-content: center; border: 2px solid #00e5ff; border-radius: 50%; background: rgba(0,229,255,.12); box-shadow: 0 0 15px rgba(0,229,255,.25); color: #00e5ff; font-size: 28px; }
  #account-account .bg-cyan-glow { background: #00e5ff !important; box-shadow: 0 0 8px rgba(0,229,255,.4); }
  #account-account .order-status-box { border: 1px solid #334155; background: #1e293b; transition: all .2s ease; }
  #account-account .order-status-box:hover { transform: translateY(-2px); border-color: #00e5ff; background: rgba(0,229,255,.08); }
  #account-account .order-tracker-card { height: 100%; padding: 16px; border-radius: 13px; color: #e2e8f0; text-decoration: none; }
  #account-account .order-tracker-card:hover { color: #fff; }
  #account-account .order-tracker-id { color: #f8fafc; font-weight: 750; }
  #account-account .order-tracker-meta { color: #94a3b8; font-size: .82rem; }
  #account-account .member-kicker { color: var(--member-cyan); font-size: .75rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  #account-account .member-hero h1 { margin: 8px 0; color: #f8fafc; font-size: clamp(1.6rem, 3vw, 2.35rem); font-weight: 800; }
  #account-account .member-hero p { max-width: 620px; margin: 0; color: #a9b8ca; }
  #account-account .member-identity { display: inline-flex; align-items: center; gap: 10px; margin-top: 20px; padding: 8px 13px; border: 1px solid var(--member-line); border-radius: 999px; background: rgba(8,15,27,.58); color: #dbe7f4; font-size: .9rem; }
  #account-account .member-identity i { color: var(--member-cyan); }
  #account-account .member-stats { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  #account-account .member-stat { min-width: 145px; padding: 10px 13px; border: 1px solid var(--member-line); border-radius: 11px; background: rgba(8,15,27,.58); }
  #account-account .member-stat strong { display: block; color: #f8fafc; font-size: 1.05rem; }
  #account-account .member-stat span { color: #8fa1b6; font-size: .78rem; }
  #account-account .member-section-title { color: #f1f5f9; font-size: 1.15rem; font-weight: 750; }
  #account-account .member-section-note { color: #8fa1b6; font-size: .9rem; }
  #account-account .member-card { height: 100%; padding: 22px; border: 1px solid var(--member-line); border-radius: 16px; background: linear-gradient(145deg, rgba(17,27,45,.98), rgba(12,19,32,.98)); }
  #account-account .member-card-head { display: flex; align-items: flex-start; gap: 13px; margin-bottom: 18px; }
  #account-account .member-icon { display: grid; flex: 0 0 44px; width: 44px; height: 44px; place-items: center; border: 1px solid rgba(34,211,238,.2); border-radius: 13px; background: rgba(34,211,238,.1); color: var(--member-cyan); font-size: 1.05rem; }
  #account-account .member-card h2 { margin: 2px 0 4px; color: #f1f5f9; font-size: 1.05rem; font-weight: 750; }
  #account-account .member-card-head p { margin: 0; color: #8fa1b6; font-size: .84rem; }
  #account-account .account-glass-card { display: flex; min-height: 88px; align-items: center; gap: 14px; padding: 18px 20px; border: 1px solid #1e293b; border-radius: 14px; background: #0f172a; box-shadow: 0 4px 20px rgba(0,0,0,.2); color: #e2e8f0; text-decoration: none; transition: all .2s cubic-bezier(.4,0,.2,1); }
  #account-account .member-benefits-grid > div { display: flex; }
  #account-account .member-benefits-grid .member-benefit-card { width: 100%; height: 100%; min-height: 150px; padding: 16px; }
  #account-account .member-benefit-card > div:last-child { min-width: 0; flex: 1; }
  #account-account .member-benefit-card h3 { line-height: 1.35; }
  #account-account .member-benefit-card > div:last-child > span { display: block; line-height: 1.55; }
  #account-account .account-glass-card:hover { transform: translateY(-3px); border-color: #00e5ff; background: #1e293b; box-shadow: 0 8px 25px rgba(0,229,255,.15); color: #fff; }
  #account-account .card-icon-box { display: flex; flex: 0 0 46px; width: 46px; height: 46px; align-items: center; justify-content: center; border: 1px solid rgba(0,229,255,.3); border-radius: 12px; background: rgba(0,229,255,.1); color: #00e5ff; font-size: 18px; }
  #account-account .account-glass-card h3 { margin: 0 0 4px; color: #f8fafc; font-size: .9rem; font-weight: 750; }
  #account-account .account-glass-card span { color: #94a3b8; font-size: .78rem; }
  #account-account .member-link-list { display: grid; grid-template-columns: 1fr; gap: 8px; margin: 0; padding: 0; list-style: none; }
  #account-account .member-link-list a:after { content: "\203a"; font-size: 1.25rem; line-height: 1; color: #71839a; }
  #account-account .member-link-list a:hover { transform: translateX(2px); border-color: rgba(34,211,238,.22); background: rgba(34,211,238,.07); color: var(--member-cyan); }
  #account-account .member-link-list a:hover:after { color: var(--member-cyan); }
  #account-account .member-feature-link { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 18px; padding: 13px 15px; border-radius: 11px; background: var(--member-cyan); color: #06202a; font-weight: 750; text-decoration: none; }
  #account-account .member-feature-link:hover { color: #06202a; filter: brightness(1.06); }
  #account-account .member-feature-link i { font-size: .9rem; }
  #account-account .member-tier-card { overflow: hidden; }
  #account-account .member-tier-topline { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  #account-account .member-tier-current { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border: 1px solid rgba(34,211,238,.28); border-radius: 999px; background: rgba(34,211,238,.1); color: #b8f5ff; font-size: .88rem; font-weight: 750; }
  #account-account .member-tier-progress-wrap { margin-top: 20px; padding: 18px; border: 1px solid rgba(148,163,184,.16); border-radius: 14px; background: rgba(8,15,27,.48); }
  #account-account .member-tier-progress-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; margin-bottom: 10px; color: #cbd5e1; font-size: .86rem; }
  #account-account .member-tier-progress { height: 10px; overflow: hidden; border-radius: 999px; background: #26364d; }
  #account-account .member-tier-progress .progress-bar { border-radius: inherit; background: linear-gradient(90deg, #06b6d4, #67e8f9); box-shadow: 0 0 16px rgba(34,211,238,.4); }
  #account-account .member-tier-remaining { margin: 10px 0 0; color: #67e8f9; font-size: .9rem; font-weight: 700; }
  #account-account .member-tier-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-top: 16px; }
  #account-account .member-tier-level { min-width: 0; padding: 15px; border: 1px solid var(--member-line); border-radius: 13px; background: rgba(8,15,27,.48); }
  #account-account .member-tier-level.is-current { border-color: rgba(34,211,238,.6); background: linear-gradient(145deg, rgba(8,145,178,.16), rgba(8,15,27,.7)); box-shadow: inset 0 0 0 1px rgba(34,211,238,.12); }
  #account-account .member-tier-level h3 { margin: 0 0 7px; color: #f8fafc; font-size: .96rem; font-weight: 800; }
  #account-account .member-tier-level p { margin: 0; color: #94a3b8; font-size: .78rem; line-height: 1.5; }
  #account-account .member-tier-level .member-tier-benefit { margin-top: 9px; color: #a5f3fc; }
  #account-account .member-tier-help { display: flex; justify-content: flex-end; margin-top: 14px; }
  #account-account .member-tier-help-toggle { display: grid; width: 36px; height: 36px; place-items: center; border: 1px solid rgba(34,211,238,.38); border-radius: 50%; background: rgba(34,211,238,.1); color: #67e8f9; cursor: pointer; font-size: 1rem; transition: background .2s ease, color .2s ease, box-shadow .2s ease; }
  #account-account .member-tier-help-toggle:hover, #account-account .member-tier-help-toggle:focus-visible, #account-account .member-tier-help-toggle[aria-expanded="true"] { background: #22d3ee; color: #06202a; box-shadow: 0 0 16px rgba(34,211,238,.2); }
  #account-account .member-tier-help-panel { width: 100%; margin-top: 10px; padding: 16px; border: 1px solid rgba(148,163,184,.18); border-radius: 13px; background: rgba(8,15,27,.72); }
  #account-account .member-tier-help-panel[hidden] { display: none !important; }
  #account-account .member-tier-help-panel .member-section-title { margin: 0; font-size: 1rem; }
  #account-account .member-tier-guide { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 12px 0 0; padding: 0; list-style: none; counter-reset: member-steps; }
  #account-account .member-tier-guide li { display: flex; align-items: flex-start; gap: 10px; color: #a9b8ca; font-size: .83rem; line-height: 1.55; counter-increment: member-steps; }
  #account-account .member-tier-guide li:before { display: grid; flex: 0 0 23px; width: 23px; height: 23px; place-items: center; border-radius: 50%; background: rgba(34,211,238,.12); color: #67e8f9; content: counter(member-steps); font-size: .72rem; font-weight: 800; }
  #account-account .member-tier-note { margin: 14px 0 0; color: #71839a; font-size: .78rem; line-height: 1.55; }
  @media (min-width: 768px) { #account-account .member-link-list.two-column { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767.98px) { #account-account .member-tier-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 575.98px) { #account-account .member-card { padding: 18px; } #account-account .member-identity { max-width: 100%; overflow-wrap: anywhere; } #account-account .member-tier-topline { flex-direction: column; } #account-account .member-tier-guide { grid-template-columns: 1fr; } }
</style>

<div id="account-account" class="container pd-standard-page py-3">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb panda-breadcrumb px-3 py-2 rounded-3">
      {% for breadcrumb in breadcrumbs %}
        {% if loop.last %}
          <li class="breadcrumb-item active" aria-current="page">{{ breadcrumb.text }}</li>
        {% else %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endif %}
      {% endfor %}
    </ol>
  </nav>

  {% if success %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-circle-check me-2"></i>{{ success }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ text_close }}"></button>
    </div>
  {% endif %}

  <div class="member-hero mb-4">
    <div class="d-flex align-items-center gap-3 mb-2">
      <div class="panda-avatar-circle"><i class="fa-solid fa-user"></i></div>
      <div><div class="member-kicker">PanDaShop · PanDaMember</div><h1>{{ text_member_welcome }}, {{ customer_firstname }}!</h1></div>
    </div>
    <p>{{ text_member_subtitle }}</p>
    <div class="member-identity"><i class="fa-solid fa-user-shield"></i><span>{{ customer_email }}</span></div>
    {% if customer_telephone %}<div class="member-identity ms-2"><i class="fa-solid fa-phone"></i><span>{{ customer_telephone }}</span></div>{% endif %}
    {% if customer_group_name %}<div class="member-identity ms-2"><i class="fa-solid fa-medal"></i><span>{{ text_member_rank }}: {{ customer_group_name }}</span></div>{% endif %}
    <div class="member-stats">
      <div class="member-stat"><strong>{{ reward_points }}</strong><span>{{ text_reward_points }}</span></div>
      <div class="member-stat"><strong>{{ wishlist_total }}</strong><span>{{ text_wishlist_total }}</span></div>
      <div class="member-stat"><strong>{{ orders_total }}</strong><span>{{ text_orders_total }}</span></div>
      <div class="member-stat"><strong>{{ total_downloads }}</strong><span>{{ text_total_downloads }}</span></div>
      <div class="member-stat"><strong>{{ balance }}</strong><span>{{ text_account_balance }}</span></div>
    </div>
  </div>

  <section class="member-card member-tier-card mb-4" aria-labelledby="member-tier-title">
    <div class="member-tier-topline">
      <div>
        <div class="member-card-head mb-0">
          <span class="member-icon"><i class="fa-solid fa-medal"></i></span>
          <div><h2 id="member-tier-title">{{ text_member_tier_title }}</h2><p>{{ text_member_tier_description }}</p></div>
        </div>
      </div>
      <span class="member-tier-current"><i class="fa-solid fa-crown" aria-hidden="true"></i>{{ text_member_tier_current_label }}: {{ member_tier_current_name }}</span>
    </div>

    <div class="member-tier-progress-wrap">
      <div class="member-tier-progress-meta">
        <span>{{ text_member_tier_current_orders }}: <strong>{{ member_completed_orders }}</strong></span>
        <span>{{ member_tier_progress_text }}</span>
      </div>
      <div class="progress member-tier-progress" role="progressbar" aria-label="{{ text_member_tier_title }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ member_tier_progress_percent }}">
        <div class="progress-bar" style="width: {{ member_tier_progress_percent }}%"></div>
      </div>
      <p class="member-tier-remaining">{{ member_tier_remaining_text }}</p>
    </div>

    <div class="member-tier-grid" aria-label="{{ text_member_tier_unlocks }}">
      {% for tier in member_tier_levels %}
        <article class="member-tier-level{% if tier.is_current %} is-current{% endif %}">
          <h3>{{ tier.name }}{% if tier.is_current %} <i class="fa-solid fa-circle-check text-info" aria-label="{{ text_member_tier_current_label }}"></i>{% endif %}</h3>
          <p>{{ tier.threshold }}</p>
          <p class="member-tier-benefit">{{ tier.benefit }}</p>
        </article>
      {% endfor %}
    </div>

    <div class="member-tier-help">
      <button type="button" class="member-tier-help-toggle" aria-expanded="false" aria-controls="member-tier-help-panel" aria-label="{{ text_member_tier_guide_title }}" title="{{ text_member_tier_guide_title }}"><i class="fa-regular fa-circle-question" aria-hidden="true"></i></button>
    </div>
    <div id="member-tier-help-panel" class="member-tier-help-panel" hidden>
      <h3 class="member-section-title">{{ text_member_tier_guide_title }}</h3>
      <ol class="member-tier-guide">
        <li>{{ text_member_tier_guide_step_one }}</li>
        <li>{{ text_member_tier_guide_step_two }}</li>
        <li>{{ text_member_tier_guide_step_three }}</li>
        <li>{{ text_member_tier_guide_step_four }}</li>
      </ol>
      <p class="member-tier-note">{{ text_member_tier_note }}</p>
    </div>
  </section>

  <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
    <div>
      <div class="member-section-title">{{ heading_title }}</div>
      <div class="member-section-note">{{ text_member_since }}</div>
    </div>
    <a class="btn btn-outline-info btn-sm" href="{{ edit }}"><i class="fa-regular fa-pen-to-square me-1"></i>{{ button_edit_profile }}</a>
  </div>

  <section class="member-card mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
      <div><h2 class="member-section-title mb-1"><i class="fa-solid fa-truck-fast text-info me-2"></i>{{ text_order_tracker }}</h2><p class="member-section-note mb-0">{{ text_recent_orders }}</p></div>
      <a class="btn btn-outline-info btn-sm" href="{{ order }}">{{ button_view_orders }} <i class="fa-solid fa-arrow-right ms-1"></i></a>
    </div>
    {% if recent_order %}
      <div class="recent-order-card">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
          <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2"><span class="order-tracker-id">#{{ recent_order.order_id }}</span><span class="order-status-badge">{{ recent_order.status }}</span></div>
            <div class="order-tracker-meta">{{ text_order_date }}: {{ recent_order.date_added }}</div>
          </div>
          <div class="text-md-end"><div class="member-section-note">{{ text_order_total }}</div><strong class="text-light">{{ recent_order.total }}</strong></div>
          <a href="{{ recent_order.view }}" class="btn btn-info btn-sm fw-semibold">{{ text_view_order }} <i class="fa-solid fa-arrow-right ms-1"></i></a>
        </div>
      </div>
    {% else %}
      <div class="recent-order-card d-flex flex-wrap align-items-center justify-content-between gap-3">
        <p class="member-section-note mb-0">{{ text_no_orders }}</p>
        <a href="{{ continue }}" class="btn btn-info btn-sm fw-semibold">{{ text_explore_products }} <i class="fa-solid fa-arrow-right ms-1"></i></a>
      </div>
    {% endif %}
  </section>

  <div class="row g-3 mb-4">
    <div class="col-12 col-lg-6">
      <section class="member-card">
        <div class="member-card-head">
          <span class="member-icon"><i class="fa-solid fa-user-lock"></i></span>
          <div><h2>{{ text_account_security }}</h2><p>{{ text_account_short }}</p></div>
        </div>
        <div class="row g-2">
          <div class="col-12 col-md-6"><a href="{{ edit }}" class="account-glass-card"><div class="card-icon-box"><i class="fa-solid fa-user-pen"></i></div><div><h3>{{ text_edit }}</h3><span>{{ text_profile_update }}</span></div></a></div>
          <div class="col-12 col-md-6"><a href="{{ password }}" class="account-glass-card"><div class="card-icon-box"><i class="fa-solid fa-shield-halved"></i></div><div><h3>{{ text_password }}</h3><span>{{ text_security_hint }}</span></div></a></div>
          <div class="col-12 col-md-6"><a href="{{ address }}" class="account-glass-card"><div class="card-icon-box"><i class="fa-solid fa-map-location-dot"></i></div><div><h3>{{ text_address }}</h3><span>{{ text_address_hint }}</span></div></a></div>
          <div class="col-12 col-md-6"><a href="{{ payment_method }}" class="account-glass-card"><div class="card-icon-box"><i class="fa-solid fa-credit-card"></i></div><div><h3>{{ text_payment_method }}</h3><span>{{ text_payment_hint }}</span></div></a></div>
        </div>
      </section>
    </div>
    <div class="col-12 col-lg-6">
      <section class="member-card">
        <div class="member-card-head">
          <span class="member-icon"><i class="fa-solid fa-box-open"></i></span>
          <div><h2>{{ text_my_orders }}</h2><p>{{ text_order_short }}</p></div>
        </div>
        <ul class="member-link-list two-column">
          <li><a href="{{ order }}">{{ text_order }} <span class="count-badge-cyan">{{ total_orders }}</span></a></li>
          <li><a href="{{ subscription }}">{{ text_subscription }}</a></li>
          <li><a href="{{ download }}">{{ text_download }} <span class="count-badge-cyan">{{ total_downloads }}</span></a></li>
          <li><a href="{{ return }}">{{ text_return }}</a></li>
          <li><a href="{{ transaction }}">{{ text_transaction }}</a></li>
          <li><a href="{{ questions }}">{{ text_product_questions }}{% if questions_unread %} <span class="count-badge-cyan">{{ questions_unread }}</span>{% endif %}</a></li>
        </ul>
        <a class="member-feature-link" href="{{ order }}"><span>{{ button_view_orders }}</span><i class="fa-solid fa-arrow-right"></i></a>
      </section>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-12 {% if affiliate %}col-lg-6{% else %}col-lg-12{% endif %}">
      <section class="member-card">
        <div class="member-card-head">
          <span class="member-icon"><i class="fa-solid fa-heart"></i></span>
          <div><h2>{{ text_member_benefits }}</h2><p>{{ text_benefit_short }}</p></div>
        </div>
        <div class="row g-2 member-benefits-grid">
          <div class="col-12 col-md-6 col-lg-4"><a href="{{ wishlist }}" class="account-glass-card member-benefit-card"><div class="card-icon-box"><i class="fa-solid fa-heart"></i></div><div><h3>{{ text_wishlist }}</h3><span><span class="count-badge-cyan">{{ total_wishlist }}</span> {{ text_wishlist_saved }}</span></div></a></div>
          {% if reward %}<div class="col-12 col-md-6 col-lg-4"><a href="{{ reward }}" class="account-glass-card member-benefit-card"><div class="card-icon-box"><i class="fa-solid fa-coins"></i></div><div><h3>{{ text_reward_points }}</h3><span>{{ reward_points }} · {{ text_reward_history_hint }}</span></div></a></div>{% endif %}
          <div class="col-12 col-md-6 col-lg-4"><a href="{{ newsletter }}" class="account-glass-card member-benefit-card"><div class="card-icon-box"><i class="fa-solid fa-bell"></i></div><div><h3>{{ text_newsletter_title }}</h3><span>{{ text_newsletter_sub }}</span></div></a></div>
        </div>
      </section>
    </div>
    {% if affiliate %}
      <div class="col-12 col-lg-6">
        <section class="member-card">
          <div class="member-card-head pd-account-affiliate-head">
            <span class="member-icon"><i class="fa-solid fa-share-nodes"></i></span>
            <div><h2>{{ text_my_affiliate }}</h2><p>{{ text_affiliate_subtitle }}</p></div>
            <span class="pd-account-affiliate-status{% if affiliate_status_text == text_affiliate_status_active %} is-active{% elseif affiliate_status_text == text_affiliate_status_pending %} is-pending{% endif %}">{{ affiliate_status_text }}</span>
          </div>
          <div class="pd-account-affiliate-actions">
            <a class="pd-account-affiliate-primary" href="{{ affiliate }}"><i class="fa-solid fa-sliders" aria-hidden="true"></i><span>{% if affiliate_exists %}{{ text_affiliate_edit }}{% else %}{{ text_affiliate_add }}{% endif %}</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            {% if tracking %}<a class="pd-account-affiliate-secondary" href="{{ tracking }}"><i class="fa-solid fa-link" aria-hidden="true"></i>{{ text_tracking }}</a>{% endif %}
          </div>
        </section>
      </div>
    {% endif %}
  </div>
</div>
{{ footer }}
