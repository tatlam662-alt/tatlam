<script>
(function () {
  'use strict';
  var form = document.getElementById('form-address');
  if (!form) return;

  // Clear stale server feedback as soon as the customer corrects a field.
  form.addEventListener('input', clearFieldError);
  form.addEventListener('change', clearFieldError);

  function clearFieldError(event) {
    var field = event.target;
    if (!field || !field.id) return;
    field.classList.remove('is-invalid');
    var feedback = document.getElementById('error-' + field.id.replace(/^input-/, ''));
    if (feedback) {
      feedback.textContent = '';
      feedback.classList.remove('d-block');
    }
    var alertBox = document.getElementById('panda-address-save-alert');
    if (alertBox && !form.querySelector('.invalid-feedback.d-block')) {
      alertBox.classList.add('d-none');
    }
  }

  form.addEventListener('submit', function (event) {
    event.preventDefault();
    event.stopImmediatePropagation();

    // Prepare the same normalized address values as the legacy submit handler
    // before serializing; this handler intentionally owns the AJAX submission.
    var country = document.getElementById('input-country');
    var province = document.getElementById('input-zone');
    var ward = document.getElementById('input-ward');
    var city = document.getElementById('input-city');
    var provinceName = document.getElementById('input-province-name');
    var wardName = document.getElementById('input-ward-name');
    var postcode = document.getElementById('input-postcode');
    var wardValue = ward ? ward.value : '';
    var provinceValue = province ? province.value : '';
    if (country) country.value = '230';
    if (province) {
      province.name = 'zone_id';
      province.disabled = false;
      if (provinceValue) province.value = provinceValue;
    }
    if (ward) {
      ward.name = 'ward_code';
      ward.disabled = false;
      if (wardValue) ward.value = wardValue;
    }
    var provinceLabel = province && province.selectedIndex >= 0 ? province.options[province.selectedIndex].text : '';
    if (city && provinceLabel) city.value = provinceLabel;
    if (provinceName) provinceName.value = provinceLabel;
    var wardLabel = ward && ward.selectedIndex >= 0 ? ward.options[ward.selectedIndex].text : '';
    if (wardName) wardName.value = wardLabel;
    if (postcode) postcode.value = '';
    var phone = document.getElementById('input-telephone');
    if (phone) phone.value = phone.value.replace(/\D/g, '');
    var address2 = document.getElementById('input-address-2');
    if (address2 && ward && ward.selectedIndex >= 0 && ward.value) {
      var addressParts = ['Phường/Xã: ' + ward.options[ward.selectedIndex].text];
      var hamlet = document.getElementById('input-hamlet');
      var subhamlet = document.getElementById('input-subhamlet-name');
      if (hamlet && hamlet.value.trim()) addressParts.push('Tổ dân phố/Khu phố/Thôn: ' + hamlet.value.trim());
      if (subhamlet && subhamlet.value.trim()) addressParts.push('Xóm/Ấp: ' + subhamlet.value.trim());
      address2.value = addressParts.join(' | ');
    }

    var button = form.querySelector('button[type="submit"]');
    var originalButton = button ? button.innerHTML : '';
    var alertBox = document.getElementById('panda-address-save-alert');

    if (!alertBox) {
      alertBox = document.createElement('div');
      alertBox.id = 'panda-address-save-alert';
      alertBox.className = 'alert d-none';
      form.insertBefore(alertBox, form.firstChild);
    }
    alertBox.className = 'alert d-none';
    alertBox.textContent = '';
    form.querySelectorAll('.is-invalid').forEach(function (element) { element.classList.remove('is-invalid'); });
    form.querySelectorAll('.invalid-feedback.d-block').forEach(function (element) { element.classList.remove('d-block'); });

    if (button) {
      button.disabled = true;
      button.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Đang lưu địa chỉ...';
    }

    var payload = new URLSearchParams();
    new FormData(form).forEach(function (value, key) { payload.append(key, value); });
    // Read critical values from the original native form controls;
    // keep them in the AJAX payload.
    ['firstname', 'lastname', 'telephone', 'address_1', 'hamlet_name', 'subhamlet_name', 'default'].forEach(function (name) {
      var control = name === 'default'
        ? form.querySelector('[name="default"]:checked')
        : form.querySelector('[name="' + name + '"]');
      if (control && !control.disabled) payload.set(name, control.value);
    });
    // Always submit both keys. Disabled selects are omitted by FormData, so
    // force their authoritative values into the request (empty means missing).
    payload.set('zone_id', provinceValue);
    payload.set('ward_code', wardValue);
    payload.set('country_id', '230');
    if (city) payload.set('city', city.value);
    if (provinceName) payload.set('province_name', provinceName.value);
    if (wardName) payload.set('ward_name', wardName.value);
    if (address2) payload.set('address_2', address2.value);
    if (postcode) payload.set('postcode', '');

    fetch(form.action, {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: payload.toString()
    }).then(function (response) {
      return response.text().then(function (body) {
        try {
          return JSON.parse(body);
        } catch (error) {
          if (response.redirected) throw new Error('Phiên đăng nhập đã hết hạn. Hãy đăng nhập lại rồi lưu địa chỉ.');
          throw new Error('Máy chủ không trả JSON (HTTP ' + response.status + '). Kiểm tra lại đường dẫn lưu địa chỉ.');
        }
      });
    }).then(function (json) {
      if (json.redirect) {
        window.pdNavigateWithinShop(json.redirect);
        return;
      }

      if (json.error) {
        var messages = [];
        var fieldErrors = 0;
        if (typeof json.error === 'string') messages.push(json.error);
        else Object.keys(json.error).forEach(function (key) {
          var message = json.error[key];
          if (key === 'warning') {
            messages.push(message);
            return;
          }
          var fieldId = 'input-' + key.replace(/_/g, '-');
          var field = document.getElementById(fieldId);
          var feedback = document.getElementById('error-' + key.replace(/_/g, '-'));
          if (field) field.classList.add('is-invalid');
          if (feedback) {
            feedback.textContent = message;
            feedback.classList.add('d-block');
            fieldErrors++;
          } else {
            messages.push(message);
          }
        });
        if (json._debug) {
          messages.push('Thông tin kiểm tra (không gồm dữ liệu cá nhân): ' + JSON.stringify(json._debug));
        }
        if (messages.length || fieldErrors) {
          alertBox.textContent = messages.join(' ') || 'Vui lòng kiểm tra lại các trường được đánh dấu.';
          alertBox.className = 'alert alert-danger';
        }
        return;
      }

      alertBox.textContent = json.success || 'Đã lưu địa chỉ thành công.';
      alertBox.className = 'alert alert-success';
      if (button) {
        button.disabled = true;
        button.textContent = 'Đã lưu địa chỉ';
      }
      if (json.success && window.location.search.indexOf('return=checkout') !== -1) {
        window.setTimeout(function () { window.pdNavigateWithinShop('{{ checkout|escape('js') }}'); }, 700);
      }
    }).catch(function (error) {
      alertBox.textContent = error && error.message ? error.message : 'Network request failed';
      alertBox.className = 'alert alert-danger';
    }).finally(function () {
      if (button && alertBox.classList.contains('alert-danger')) {
        button.disabled = false;
        button.innerHTML = originalButton;
      }
    });
  }, true);
})();
</script>{{ footer }}
