{{ header }}
<div id="account-address" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> {{ success }}</div>
  {% endif %}
  <div class="row">{{ column_left }}
    <div id="content" class="col">{{ content_top }}
      <div class="pd-address-page-heading">
        <span class="pd-address-page-icon" aria-hidden="true"><i class="fa-solid fa-location-dot"></i></span>
        <div><span class="pd-address-eyebrow">TÀI KHOẢN PANDASHOP</span><h1>{{ text_address_book }}</h1><p>Quản lý địa chỉ giao hàng để đặt hàng nhanh và chính xác hơn.</p></div>
        <a href="{{ add }}" class="btn btn-primary pd-address-add-top"><i class="fa-solid fa-plus me-2" aria-hidden="true"></i>{{ button_new_address }}</a>
      </div>
      <div id="address">{{ list }}</div>
      <div class="mt-3"><a href="{{ back }}" class="btn btn-light">{{ button_back }}</a></div>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
<script type="text/javascript"><!--
$('#address').on('click', '.account-icon-action.is-danger', function(e) {
    e.preventDefault();

    if (!window.confirm('Bạn có chắc muốn xóa địa chỉ này?')) {
        return;
    }

    var element = this;
    var $element = $(element);

    $.ajax({
        url: $element.attr('href'),
        dataType: 'json',
        beforeSend: function() {
            $element.attr('aria-disabled', 'true').addClass('is-loading');
        },
        complete: function() {
            $element.removeAttr('aria-disabled').removeClass('is-loading');
        },
        success: function(json) {
            $('.alert-dismissible').remove();

            if (json['error']) {
                $('<div>', { 'class': 'alert alert-danger alert-dismissible' })
                    .append($('<i>', { 'class': 'fa-solid fa-circle-exclamation', 'aria-hidden': 'true' }))
                    .append(document.createTextNode(' ' + json['error'] + ' '))
                    .append($('<button>', { 'type': 'button', 'class': 'btn-close', 'data-bs-dismiss': 'alert', 'aria-label': 'Close' }))
                    .insertBefore('#address');
            }

            if (json['success']) {
                $('<div>', { 'class': 'alert alert-success alert-dismissible' })
                    .append($('<i>', { 'class': 'fa-solid fa-circle-check', 'aria-hidden': 'true' }))
                    .append(document.createTextNode(' ' + json['success'] + ' '))
                    .append($('<button>', { 'type': 'button', 'class': 'btn-close', 'data-bs-dismiss': 'alert', 'aria-label': 'Close' }))
                    .insertBefore('#address');

                $('#address').load('index.php?route=account/address.list&language={{ language }}&customer_token={{ customer_token }}');
            }
        },
        error: function() {
            $('.alert-dismissible').remove();
            $('<div>', { 'class': 'alert alert-danger alert-dismissible' })
                .append($('<i>', { 'class': 'fa-solid fa-circle-exclamation', 'aria-hidden': 'true' }))
                .append(document.createTextNode(' Không thể xử lý yêu cầu lúc này. Vui lòng tải lại trang và thử lại. '))
                .append($('<button>', { 'type': 'button', 'class': 'btn-close', 'data-bs-dismiss': 'alert', 'aria-label': 'Close' }))
                .insertBefore('#address');
        }
    });
});
//--></script>
{{ footer }}
