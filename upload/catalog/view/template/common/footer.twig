{% for script in scripts %}
  <script src="{{ script.href }}" type="text/javascript"></script>
{% endfor %}
<script type="text/javascript">
(() => {
  const toggle = document.getElementById('btn-toggle-dock');
  const items = document.getElementById('dock-menu-items');
  const dock = document.getElementById('panda-quick-dock');
  if (toggle && items && dock) {
    toggle.addEventListener('click', () => {
      const isOpen = dock.dataset.open === 'true';
      dock.dataset.open = String(!isOpen);
      toggle.setAttribute('aria-expanded', String(!isOpen || dock.matches(':hover') || dock.matches(':focus-within')));
      toggle.setAttribute('aria-label', isOpen ? toggle.dataset.openLabel : toggle.dataset.closeLabel);
      toggle.querySelector('i').classList.toggle('fa-comments', isOpen);
      toggle.querySelector('i').classList.toggle('fa-xmark', !isOpen);
    });
    dock.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse' && dock.dataset.open !== 'true') toggle.setAttribute('aria-expanded', 'true');
    });
    dock.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse' && dock.dataset.open !== 'true') toggle.setAttribute('aria-expanded', String(dock.matches(':focus-within')));
    });
    dock.addEventListener('focusout', () => window.setTimeout(() => {
      if (dock.dataset.open !== 'true' && !dock.matches(':hover') && !dock.matches(':focus-within')) toggle.setAttribute('aria-expanded', 'false');
    }, 0));
  }

  const form = document.getElementById('form-panda-ai-chat');
  const input = document.getElementById('ai-input-msg');
  const messages = document.getElementById('ai-chat-messages');
  if (form && input && messages) {
    const sendAiMessage = async (userMsg) => {
      const message = String(userMsg || '').trim();
      if (!message || form.dataset.sending === 'true') return;

      const userMessage = document.createElement('div');
      userMessage.className = 'panda-ai-message panda-ai-message--user';
      userMessage.textContent = message;
      messages.appendChild(userMessage);
      input.value = '';
      messages.scrollTop = messages.scrollHeight;
      form.dataset.sending = 'true';
      const submitButton = form.querySelector('button[type="submit"]');
      if (submitButton) submitButton.disabled = true;
      const typing = document.createElement('div');
      typing.className = 'panda-ai-message panda-ai-message--assistant panda-ai-typing';
      typing.setAttribute('role', 'status');
      typing.textContent = form.dataset.typingMessage;
      messages.appendChild(typing);
      messages.scrollTop = messages.scrollHeight;

      const controller = new AbortController();
      const timeoutId = window.setTimeout(() => controller.abort(), 15000);
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Accept': 'application/json', 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ message }),
          signal: controller.signal
        });
        const data = await response.json().catch(() => null);
        if (!data || !response.ok || !data.success) throw new Error(data && data.error ? data.error : form.dataset.sendError);

        const reply = document.createElement('div');
        reply.className = 'panda-ai-message panda-ai-message--assistant';
        reply.textContent = data.reply || form.dataset.noReply;
        messages.appendChild(reply);

        (Array.isArray(data.products) ? data.products : []).forEach((product) => {
          if (!product || !product.href || !product.name) return;
          const card = document.createElement('a');
          card.className = 'panda-ai-message panda-ai-product';
          card.href = product.href;
          card.rel = 'noopener';
          const image = document.createElement('img');
          image.src = product.image || '';
          image.alt = product.name;
          image.width = 56;
          image.height = 56;
          image.loading = 'lazy';
          const details = document.createElement('span');
          details.className = 'panda-ai-product-details';
          const name = document.createElement('strong');
          name.textContent = product.name;
          details.append(name);
          if (product.price) {
            const price = document.createElement('span');
            price.textContent = product.price;
            details.append(price);
          }
          card.append(image, details);
          messages.appendChild(card);
        });
      } catch (error) {
        const reply = document.createElement('div');
        reply.className = 'panda-ai-message panda-ai-message--assistant';
        reply.textContent = error instanceof Error && error.name !== 'AbortError' ? error.message : form.dataset.connectionError;
        messages.appendChild(reply);
      } finally {
        window.clearTimeout(timeoutId);
        typing.remove();
        form.dataset.sending = 'false';
        if (submitButton) submitButton.disabled = false;
        messages.scrollTop = messages.scrollHeight;
        input.focus();
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      sendAiMessage(input.value);
    });

    const chatModal = messages.closest('.panda-ai-modal');
    if (chatModal) chatModal.addEventListener('click', (event) => {
      const chip = event.target.closest('.btn-ai-chip');
      if (chip) sendAiMessage(chip.dataset.msg || chip.textContent);
    });
  }
})();
</script>
<script type="text/javascript">
(() => {
  const button = document.getElementById('pd-scroll-to-top');
  if (!button) return;

  let updateScheduled = false;
  const updateVisibility = () => {
    button.classList.toggle('is-visible', window.scrollY > 320);
    updateScheduled = false;
  };

  window.addEventListener('scroll', () => {
    if (updateScheduled) return;
    updateScheduled = true;
    window.requestAnimationFrame(updateVisibility);
  }, { passive: true });

  button.addEventListener('click', () => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
  });

  updateVisibility();
})();
</script>
</body></html>
