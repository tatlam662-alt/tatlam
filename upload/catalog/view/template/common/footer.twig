<button type="button" id="pd-scroll-to-top" class="pd-scroll-to-top" aria-label="{{ text_back_to_top|escape }}" title="{{ text_back_to_top|escape }}">
  <span>{{ text_back_to_top }}</span>
  <i class="fa-solid fa-angles-up" aria-hidden="true"></i>
</button>

<div class="modal fade panda-ai-modal" id="pandaAiModal" tabindex="-1" aria-labelledby="pandaAiTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="panda-ai-avatar"><i class="fa-solid fa-robot" aria-hidden="true"></i><span aria-hidden="true"></span></div>
        <div class="panda-ai-heading"><h2 id="pandaAiTitle">PanDa Assistant</h2><p>{{ text_assistant_description }}</p></div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="{{ text_ai_close_dialog|escape }}"></button>
      </div>
      <div class="modal-body" id="ai-chat-messages" aria-live="polite" aria-label="{{ text_ai_chat_label|escape }}">
        <div class="panda-ai-message panda-ai-message--assistant">{{ text_assistant_greeting }}</div>
      </div>
      <div class="panda-ai-suggestions" aria-label="{{ text_ai_suggestions|escape }}">
        <button type="button" class="btn-ai-chip" data-msg="{{ text_ai_flycam_prompt|e('html_attr') }}">{{ text_ai_flycam_label }}</button>
        <button type="button" class="btn-ai-chip" data-msg="{{ text_ai_pc_prompt|e('html_attr') }}">PC Gaming</button>
        <button type="button" class="btn-ai-chip" data-msg="{{ text_ai_order_prompt|e('html_attr') }}">{{ text_ai_order_prompt }}</button>
        <button type="button" class="btn-ai-chip" data-msg="{{ text_ai_deals_prompt|e('html_attr') }}">{{ text_ai_deals_prompt }}</button>
      </div>
      <div class="modal-footer">
        <form id="form-panda-ai-chat" class="panda-ai-form" action="{{ ai_chat_url }}" method="post" data-typing-message="{{ text_assistant_typing|e('html_attr') }}" data-send-error="{{ text_ai_send_error|e('html_attr') }}" data-connection-error="{{ text_ai_connection_error|e('html_attr') }}" data-no-reply="{{ text_ai_no_reply|e('html_attr') }}">
          <label class="visually-hidden" for="ai-input-msg">{{ text_ai_message_label }}</label>
          <input type="text" id="ai-input-msg" class="form-control" placeholder="{{ text_ai_placeholder|e('html_attr') }}" required autocomplete="off" maxlength="1000">
          <button type="submit" aria-label="{{ text_ai_send_message|escape }}"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i></button>
        </form>
        <p class="panda-ai-note">{{ text_ai_note }}</p>
      </div>
    </div>
  </div>
</div>
</div>
