<footer class="pd-footer">
  <div class="container pd-footer-inner">
    <div class="row pd-footer-grid">
      <section class="col-6 col-lg-3 pd-footer-column pd-footer-brand-column">
        <a href="{{ home }}" class="pd-footer-brand">
          <img class="pd-brand-mark pd-brand-mark-footer" src="image/catalog/pandashop-panda-logo.svg" alt="" width="40" height="40" />
          <span>{{ store_name }}</span>
        </a>
        <p class="pd-footer-description">{{ text_footer_description }}</p>
      </section>

      <nav class="col-6 col-lg-3 pd-footer-column" aria-label="{{ text_footer_categories }}">
        <h2 class="pd-footer-title">{{ text_footer_categories }}</h2>
        <ul class="pd-footer-links">
          {% for category in footer_categories %}
            <li><a href="{{ category.href }}">{{ category.name }}</a></li>
          {% endfor %}
        </ul>
      </nav>

      <nav class="col-6 col-lg-3 pd-footer-column" aria-label="{{ text_footer_support }}">
        <h2 class="pd-footer-title">{{ text_footer_support }}</h2>
        <ul class="pd-footer-links">
          {% for item in footer_support_links %}
            <li><a href="{{ item.href }}">{{ item.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>

      <section class="col-6 col-lg-3 pd-footer-column">
        <h2 class="pd-footer-title">{{ text_footer_contact }}</h2>
        <ul class="pd-footer-contact-list">
          {% if telephone %}
            <li><i class="fa-solid fa-phone" aria-hidden="true"></i><a href="tel:{{ telephone|replace({' ': '', '-': '', '(': '', ')': ''}) }}">{{ telephone }}</a></li>
          {% endif %}
          {% if email %}
            <li><i class="fa-regular fa-envelope" aria-hidden="true"></i><a href="mailto:{{ email }}">{{ email }}</a></li>
          {% endif %}
          <li><i class="fa-regular fa-clock" aria-hidden="true"></i><span>{{ text_footer_hours }}: {{ text_footer_hours_value }}</span></li>
          {% if zalo %}
            <li><i class="fa-solid fa-comment-dots" aria-hidden="true"></i><a href="{{ zalo }}" target="_blank" rel="noopener noreferrer">{{ text_footer_chat }}</a></li>
          {% endif %}
          {% if address %}
            <li><i class="fa-solid fa-location-dot" aria-hidden="true"></i><span>{{ address }}</span></li>
          {% endif %}
        </ul>
      </section>
    </div>

    <div class="pd-footer-bottom">
      <span>{{ text_footer_bottom_tagline }}</span>
      <span>{{ powered }}</span>
    </div>
  </div>
</footer>
