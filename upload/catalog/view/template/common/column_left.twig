{% if account_sidebar or modules %}
<aside id="column-left" class="col-12{% if account_sidebar %} col-md-3 col-lg-3 pd-account-sidebar-column{% else %} col-md-4 col-lg-3{% endif %} mb-4">
  {% if is_category_page %}
    <button type="button" class="pd-category-filter-close" aria-label="Đóng bộ lọc"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
  {% endif %}
  {% if account_sidebar %}
    {{ account_sidebar_content }}
  {% endif %}
  {% if not account_sidebar %}
    {% for module in modules %}
      {{ module }}
    {% endfor %}
  {% endif %}
</aside>
{% endif %}
