            <p>{{ text_tags }}
              {% for tag in tags %}
                <a href="{{ tag.href }}">{{ tag.tag }}</a>{% if not loop.last %},{% endif %}
              {% endfor %}
            </p>
          {% endif %}
        </div>
        {% if attribute_groups or product_detail_specs %}
          <div id="tab-specification" class="tab-pane fade pd-pdp-tab-panel">
            <div class="pd-pdp-spec-layout">
              {% if product_detail_specs %}
                {% for spec_group in product_detail_specs %}
                  <section class="pd-pdp-spec-card">
                    <h3>{{ spec_group.group }}</h3>
                    <div class="table-responsive">
                      <table class="table pd-pdp-spec-table"><tbody>
                        {% for attribute in spec_group.attributes %}
                          <tr><th scope="row">{{ attribute.name }}</th><td>{{ attribute.text }}</td></tr>
                        {% endfor %}
                      </tbody></table>
                    </div>
                  </section>
                {% endfor %}
              {% else %}
                {% for attribute_group in attribute_groups %}
                  <section class="pd-pdp-spec-card">
                    <h3>{{ attribute_group.name }}</h3>
                    <div class="table-responsive">
                      <table class="table pd-pdp-spec-table"><tbody>
                        {% for attribute in attribute_group.attribute %}
                          <tr><th scope="row">{{ attribute.name }}</th><td>{{ attribute.text }}</td></tr>
                        {% endfor %}
                      </tbody></table>
                    </div>
                  </section>
                {% endfor %}
              {% endif %}
            </div>
            {% if product_detail_source %}
              <p class="pd-pdp-spec-source">{{ text_specs_source_before }} <a href="{{ product_detail_source|e('html_attr') }}" target="_blank" rel="noopener noreferrer">{{ text_manufacturer_documentation }}</a>. {{ text_specs_source_after }}</p>
            {% endif %}
          </div>
        {% endif %}
        {% if has_related_products %}
          <div id="tab-accessories" class="tab-pane fade pd-pdp-tab-panel"><h2 class="pd-pdp-related-title">{{ text_related_products }}</h2>{{ related }}</div>
        {% endif %}
        {% if product_detail_sections or product_in_box %}
          <div id="tab-package" class="tab-pane fade pd-pdp-tab-panel">
            <h2 class="pd-pdp-related-title">{{ text_in_the_box }}</h2>
            {% if product_detail_sections %}
              <div class="pd-pdp-package-grid">
                {% for section in product_detail_sections %}
                  <section class="pd-pdp-package-card"><span class="pd-pdp-package-icon"><i class="fa-solid fa-circle-check" aria-hidden="true"></i></span><h3>{{ section.title }}</h3><p>{{ section.text }}</p></section>
                {% endfor %}
              </div>
            {% endif %}
            {% if product_in_box %}
              <h3 class="pd-pdp-box-list-title">{{ text_box_contents_list }}</h3>
              <ul class="pd-pdp-package-list">{% for item in product_in_box %}<li><i class="fa-solid fa-check" aria-hidden="true"></i>{{ item }}</li>{% endfor %}</ul>
            {% endif %}
            {% if product_detail_source %}<p class="pd-pdp-spec-source">{{ text_package_source_before }} <a href="{{ product_detail_source|e('html_attr') }}" target="_blank" rel="noopener noreferrer">{{ text_manufacturer_information }}</a>; {{ text_package_source_after }}</p>{% endif %}
          </div>
        {% endif %}
        {% if review_status %}
          <div id="tab-review" class="tab-pane fade pd-pdp-tab-panel">
            {% if product_review_count == 0 %}<p class="pd-pdp-review-prompt">{{ text_review_prompt }}</p>{% endif %}
            {{ review }}
          </div>
        {% endif %}
        {% if product_questions %}
          <div id="tab-questions" class="tab-pane fade pd-pdp-tab-panel">{{ product_questions }}</div>
        {% endif %}
      </div>
      </section>
      <aside class="pd-pdp-contact-card">
        <span class="pd-pdp-contact-kicker"><i class="fa-solid fa-headset" aria-hidden="true"></i> {{ text_footer_support }}</span>
        <h2>{{ text_footer_contact }}</h2>
        {% if contact_telephone %}
          <a class="pd-pdp-contact-link" href="tel:{{ contact_telephone_uri|e('html_attr') }}"><i class="fa-solid fa-phone" aria-hidden="true"></i><span>{{ contact_telephone }}</span></a>
        {% endif %}
        {% if contact_email %}
          <a class="pd-pdp-contact-link" href="mailto:{{ contact_email|e('html_attr') }}"><i class="fa-solid fa-envelope" aria-hidden="true"></i><span>{{ contact_email }}</span></a>
        {% endif %}
        <div class="pd-pdp-contact-hours"><span>{{ text_footer_hours }}</span><strong>{{ text_footer_hours_value }}</strong></div>
        <a class="pd-pdp-contact-cta" href="{{ contact_url }}"><i class="fa-solid fa-comment-dots" aria-hidden="true"></i>{{ text_contact }}</a>
      </aside>
      </div>
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
<div class="pd-mobile-sticky-bar d-lg-none" role="region" aria-label="{{ heading_title }}">
  {% if price %}
    <div class="pd-mobile-sticky-price">
      {% if special %}
        <small class="text-muted text-decoration-line-through">{{ price }}</small>
        <strong class="text-danger">{{ special }}</strong>
      {% else %}
        <strong>{{ price }}</strong>
      {% endif %}
    </div>
  {% endif %}
  <button type="button" id="pd-sticky-btn-cart" class="pd-pdp-sticky-add btn-add-cart" data-product-id="{{ product_id }}" data-cart-add="{{ cart_add }}" data-cart-info="{{ cart_info }}" data-checkout="{{ checkout }}" data-cart-success="{{ text_cart_added }}">
    <i class="fa-solid fa-cart-plus" aria-hidden="true"></i> {{ button_cart }}
  </button>
  <button type="button" id="pd-sticky-btn-buy" class="pd-pdp-sticky-buy btn-buy-now" data-product-id="{{ product_id }}" data-cart-add="{{ cart_add }}" data-cart-info="{{ cart_info }}" data-checkout="{{ checkout }}" data-cart-success="{{ text_cart_added }}"><i class="fa-solid fa-bolt" aria-hidden="true"></i> {{ button_buy_now }}</button>
</div>
<script type="text/javascript"><!--
$('#input-subscription').on('change', function(e) {
    var element = this;

    $('.subscription').addClass('d-none');

    $('#subscription-description-' + $(element).val()).removeClass('d-none');
});

$('.pd-qty-step').on('click', function() {
    var input = $('#input-quantity');
    var min = parseInt(input.attr('min'), 10) || 1;
    var value = parseInt(input.val(), 10) || min;
    input.val(Math.max(min, value + (parseInt($(this).data('qty-step'), 10) || 0))).trigger('change');
});

//--></script>
{{ footer }}
