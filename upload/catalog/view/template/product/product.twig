              const mainLink = gallery.querySelector('[data-pd-main-image]');
              const mainImage = mainLink && mainLink.querySelector('img.img-thumbnail');
              if (!mainLink || !mainImage) return;

              // Keep the product image in the page; do not open a full-screen lightbox.
              mainLink.addEventListener('click', (event) => event.preventDefault());

              const updateImageAccent = () => {
                if (!mainImage.complete || !mainImage.naturalWidth) return;
                const canvas = document.createElement('canvas');
                canvas.width = 32;
                canvas.height = 32;
                const context = canvas.getContext('2d', { willReadFrequently: true });
                if (!context) return;
                context.drawImage(mainImage, 0, 0, canvas.width, canvas.height);
                const pixels = context.getImageData(0, 0, canvas.width, canvas.height).data;
                const createHueBuckets = () => Array.from({ length: 24 }, () => ({ count: 0, red: 0, green: 0, blue: 0 }));
                const hues = createHueBuckets();
                const edgeHues = createHueBuckets();
                for (let index = 0; index < pixels.length; index += 4) {
                  const pixel = index / 4;
                  const x = pixel % canvas.width;
                  const y = Math.floor(pixel / canvas.width);
                  const red = pixels[index];
                  const green = pixels[index + 1];
                  const blue = pixels[index + 2];
                  const maximum = Math.max(red, green, blue);
                  const minimum = Math.min(red, green, blue);
                  const saturation = maximum ? (maximum - minimum) / maximum : 0;
                  if (saturation < .3 || maximum < 48 || maximum > 238) continue;
                  let hue = 0;
                  if (maximum === red) hue = ((green - blue) / (maximum - minimum) + 6) % 6;
                  else if (maximum === green) hue = (blue - red) / (maximum - minimum) + 2;
                  else hue = (red - green) / (maximum - minimum) + 4;
                  const bucketIndex = Math.floor(hue * 4) % hues.length;
                  const bucket = hues[bucketIndex];
                  bucket.count++;
                  bucket.red += red;
                  bucket.green += green;
                  bucket.blue += blue;
                  if (x < 4 || y < 4 || x >= canvas.width - 4 || y >= canvas.height - 4) {
                    const edgeBucket = edgeHues[bucketIndex];
                    edgeBucket.count++;
                    edgeBucket.red += red;
                    edgeBucket.green += green;
                    edgeBucket.blue += blue;
                  }
                }
                const edgeAccent = edgeHues.reduce((best, current) => current.count > best.count ? current : best, edgeHues[0]);
                const accent = edgeAccent.count >= 28
                  ? edgeAccent
                  : hues.reduce((best, current) => current.count > best.count ? current : best, hues[0]);
                if (!accent.count) return;
                const color = [accent.red, accent.green, accent.blue]
                  .map((channel) => Math.round(channel / accent.count))
                  .join(', ');
                mainLink.style.setProperty('--pd-pdp-image-accent', color);
              };
              mainImage.addEventListener('load', updateImageAccent);
              updateImageAccent();

              const images = officialImages[gallery.dataset.productModel] || [];
              const englishGalleryLabels = {
                'Góc nhìn từ trên': 'Top view',
                'Góc nghiêng': 'Angled view',
                'Góc cạnh': 'Side angle',
                'Chi tiết sản phẩm': 'Product detail',
                'Mặt trước': 'Front view',
                'Góc bên': 'Side view',
                'Góc nhìn chi tiết': 'Detailed view',
                'Tay điều khiển DJI RC 2': 'DJI RC 2 remote controller',
                'Pin thông minh DJI Mini 4 Pro': 'DJI Mini 4 Pro Intelligent Flight Battery Plus',
                'Hub sạc DJI Mini 4 Pro': 'DJI Mini 4 Pro charging hub',
                'Cánh quạt DJI Mini 4 Pro': 'DJI Mini 4 Pro propellers',
                'Bộ kính lọc ND cho Mini 4 Pro': 'Mini 4 Pro ND filter set',
                'Mặt trước và hệ thống quạt': 'Front view and fan system',
                'Tản nhiệt và cổng kết nối': 'Cooling system and ports',
                'Mặt sau card đồ họa': 'Graphics card backplate',
                'Khe cắm và tản nhiệt': 'Expansion slots and heatsinks',
                'Cổng kết nối phía sau': 'Rear I/O ports',
                'Thiết kế M.2 NVMe': 'M.2 NVMe design',
                'Cấu tạo sản phẩm': 'Product construction',
                'Ảnh giới thiệu 990 PRO': '990 PRO product image'
              };
              const localizedImages = images.map(([source, label]) => {
                if (gallery.dataset.language !== 'en-gb' || !/[À-ỹĐđ]/.test(label)) return [source, label];
                const detailImage = label.match(/^Ảnh chi tiết sản phẩm (\d+)$/);
                return [source, detailImage ? `Product detail image ${detailImage[1]}` : (englishGalleryLabels[label] || 'Product image')];
              });

              let strip = gallery.querySelector('.pd-pdp-thumbnails');
              if (!strip) {
                strip = document.createElement('div');
                strip.className = 'pd-pdp-thumbnails pd-pdp-official-thumbnails';
                strip.setAttribute('aria-label', gallery.dataset.language === 'en-gb' ? 'Product images' : 'Ảnh chi tiết sản phẩm');
                gallery.appendChild(strip);
              }

              localizedImages.forEach(([source, label]) => {
                const button = document.createElement('a');
                button.href = source;
                button.className = 'pd-pdp-source-thumb';
                button.setAttribute('role', 'button');
                button.setAttribute('aria-label', label);
                button.title = label;

                const image = document.createElement('img');
                image.src = source;
                image.alt = `${gallery.dataset.productModel} — ${label}`;
                image.loading = 'lazy';
                image.referrerPolicy = 'no-referrer';
                image.decoding = 'async';
                image.addEventListener('error', () => button.remove(), { once: true });
                button.appendChild(image);
                strip.appendChild(button);
              });

              const featureSlide = gallery.querySelector('[data-pd-feature-slide]');
              const featureThumb = gallery.querySelector('[data-pd-feature-thumb]');
              const stage = gallery.querySelector('[data-pd-gallery-stage]');
              const slideButtons = () => Array.from(strip.querySelectorAll('a[data-pd-gallery-thumb], a.pd-pdp-source-thumb, a[data-pd-feature-thumb]'));
              const selectSlide = (button) => {
                if (!button) return;
                const showFeature = button === featureThumb;
                if (featureSlide) featureSlide.hidden = !showFeature;
                mainLink.hidden = showFeature;
                if (stage) stage.classList.toggle('is-feature-slide', showFeature);
                slideButtons().forEach((item) => {
                  const active = item === button;
                  item.classList.toggle('is-active', active);
                  if (active) {
                    item.setAttribute('aria-current', 'true');
                  } else {
                    item.removeAttribute('aria-current');
                  }
                });
                if (!showFeature) {
                  const image = button.querySelector('img');
                  if (image) {
                    mainLink.href = button.href;
                    mainImage.src = button.href;
                    mainImage.alt = image.alt;
                  }
                }
              };

              strip.addEventListener('click', (event) => {
                const button = event.target.closest('a[data-pd-gallery-thumb], a.pd-pdp-source-thumb, a[data-pd-feature-thumb]');
                if (!button) return;
                event.preventDefault();
                selectSlide(button);
              });

              const galleryArrows = stage ? stage.querySelectorAll('[data-pd-gallery-step]') : [];
              galleryArrows.forEach((button) => {
                button.hidden = slideButtons().length < 2;
                button.addEventListener('click', () => {
                  const buttons = slideButtons();
                  const activeIndex = Math.max(0, buttons.findIndex((item) => item.classList.contains('is-active')));
                  const step = Number(button.dataset.pdGalleryStep) || 0;
                  const nextIndex = (activeIndex + step + buttons.length) % buttons.length;
                  selectSlide(buttons[nextIndex]);
                });
              });

              const initialSlide = featureThumb || strip.querySelector('[data-pd-gallery-main-thumb]') || slideButtons()[0];
              selectSlide(initialSlide);
            })();
            </script>
          </div>
        {% endif %}
