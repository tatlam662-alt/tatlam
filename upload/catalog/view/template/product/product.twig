{{ header }}
<div id="product-info" class="container pd-standard-page">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  {% if stock_alert_message %}<div class="alert alert-success" role="status">{{ stock_alert_message }}</div>{% endif %}
  {% if stock_alert_error %}<div class="alert alert-danger" role="alert">{{ stock_alert_error }}</div>{% endif %}
  <div class="row">{{ column_left }}
    <div id="content" class="col">
      {{ content_top }}
      <div class="row mb-3 pd-product-detail-wrap pd-pdp-layout">
        {% if thumb or images %}
          <div class="col-sm pd-pdp-gallery-column">
            <div class="image pd-pdp-gallery" data-product-model="{{ model|e('html_attr') }}" data-language="{{ language|e('html_attr') }}">
              <div class="pd-pdp-gallery-stage" data-pd-gallery-stage>
                {% if thumb %}
                  <a href="{{ popup }}" title="{{ heading_title }}" class="pd-pdp-main-image" data-pd-main-image role="button" aria-label="{{ heading_title|e('html_attr') }}"><img src="{{ thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" class="img-thumbnail mb-3"/></a>
                {% endif %}
                {% if product_detail_highlights %}
                  <section id="pd-pdp-feature-slide" class="pd-pdp-feature-slide" data-pd-feature-slide hidden aria-label="{{ text_product_highlights }}">
                    {% if thumb %}<div class="pd-pdp-feature-slide-image"><img src="{{ popup }}" alt="{{ heading_title|e('html_attr') }}" loading="lazy"/></div>{% endif %}
                    <div class="pd-pdp-feature-slide-content">
                      <h2><span class="pd-pdp-feature-star"><i class="fa-solid fa-star" aria-hidden="true"></i></span>{{ text_product_highlights }}</h2>
                      <ul>
                        {% for highlight in product_detail_highlights %}
                          <li>{{ highlight }}</li>
                        {% endfor %}
                      </ul>
                      {% if product_detail_source %}
                        <p>{{ text_highlights_source_before }} <a href="{{ product_detail_source|e('html_attr') }}" target="_blank" rel="noopener noreferrer">{{ text_manufacturer_documentation }}</a></p>
                      {% endif %}
                    </div>
                  </section>
                {% endif %}
                <button type="button" class="pd-pdp-gallery-arrow pd-pdp-gallery-arrow-prev" data-pd-gallery-step="-1" aria-label="{{ text_previous_image }}"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
                <button type="button" class="pd-pdp-gallery-arrow pd-pdp-gallery-arrow-next" data-pd-gallery-step="1" aria-label="{{ text_next_image }}"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
              </div>
              <div class="pd-pdp-thumbnails" aria-label="{{ text_product_gallery }}">
                {% if product_detail_highlights %}
                  <a href="#pd-pdp-feature-slide" class="pd-pdp-feature-thumb" data-pd-feature-thumb aria-label="{{ text_product_highlights }}" title="{{ text_product_highlights }}"><i class="fa-solid fa-star" aria-hidden="true"></i><span>{{ text_product_highlights }}</span></a>
                {% endif %}
                {% if thumb %}
                  <a href="{{ popup }}" title="{{ heading_title }}" data-pd-gallery-thumb data-pd-gallery-main-thumb aria-label="{{ heading_title }}"><img src="{{ thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" loading="lazy"/></a>
                {% endif %}
                {% for image in images %}
                  <a href="{{ image.popup }}" title="{{ heading_title }}" data-pd-gallery-thumb><img src="{{ image.thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" loading="lazy"/></a>
                {% endfor %}
              </div>
            </div>
            {% if product_detail_video %}
              <div class="pd-pdp-video-actions">
                <a href="{{ product_detail_video|e('html_attr') }}" target="_blank" rel="noopener noreferrer" class="pd-pdp-video-link"><i class="fa-solid fa-circle-play" aria-hidden="true"></i> {{ text_video_intro }}</a>
                <span>{{ text_video_official }} {{ product_detail_video_title }}</span>
              </div>
            {% endif %}
