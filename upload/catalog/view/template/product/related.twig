{% if products %}
  <section class="pd-pdp-related" aria-labelledby="pd-pdp-related-title">
    <h2 id="pd-pdp-related-title" class="pd-pdp-related-title">{{ text_related }}</h2>
    <div class="row pd-related-products row-cols-2 row-cols-md-3 row-cols-xl-4">
      {% for product in products %}<div class="col mb-3">{{ product }}</div>{% endfor %}
    </div>
  </section>
{% endif %}

