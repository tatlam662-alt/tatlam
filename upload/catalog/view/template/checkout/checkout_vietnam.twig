<script>
(function (document, window) {
  'use strict';
  var geocodeEndpoint = {{ geocode_url|default('')|json_encode|raw }};
  var consent = document.getElementById('pd-checkout-location-consent');
  var consentDialog = consent && consent.querySelector('.pd-location-consent__dialog');
  var activeType = 'payment';
  var opener = null;

  function normalize(value) {
    return String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[đĐ]/g, 'd')
      .toLowerCase().replace(/^(tinh|thanh pho|tp\.?|phuong|xa|thi tran|province of|city of)\s+/, '').replace(/\s+/g, ' ').trim();
  }
  function status(type, message, state) {
    var card = document.querySelector('[data-pd-location="' + type + '"]');
    var element = card && card.querySelector('[data-location-status]');
    if (!element) return;
    element.textContent = message;
    element.classList.toggle('is-error', state === 'error');
    element.classList.toggle('is-success', state === 'success');
  }
  function waitForWards(ward, timeout) {
    return new Promise(function (resolve, reject) {
      var started = Date.now();
      var timer = window.setInterval(function () {
        if (!ward.disabled && ward.options.length > 1) { window.clearInterval(timer); resolve(); }
        else if (Date.now() - started > timeout) { window.clearInterval(timer); reject(new Error('Chưa tải được danh sách phường/xã.')); }
      }, 120);
    });
  }
  function getGeocode(position) {
    var lat = position.coords.latitude;
    var lon = position.coords.longitude;
    var controller = window.AbortController ? new AbortController() : null;
    var timeout = window.setTimeout(function () { if (controller) controller.abort(); }, 8000);
    var bigData = fetch('https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=' + encodeURIComponent(lat) + '&longitude=' + encodeURIComponent(lon) + '&localityLanguage=vi', controller ? { signal: controller.signal } : {})
      .then(function (response) { if (!response.ok) throw new Error('BigDataCloud'); return response.json(); }).catch(function () { return null; })
      .finally(function () { window.clearTimeout(timeout); });
    var osm = geocodeEndpoint ? fetch(geocodeEndpoint, {
      method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8', Accept: 'application/json' },
      body: new URLSearchParams({ lat: String(lat), lon: String(lon) })
    }).then(function (response) { if (!response.ok) throw new Error('OpenStreetMap'); return response.json(); }).catch(function () { return null; }) : Promise.resolve(null);
    return Promise.all([bigData, osm]).then(function (results) {
      var b = results[0], o = results[1];
      var fallback = b && {
        address: { state: b.principalSubdivision || '', province: b.principalSubdivision || '', city: b.city || b.locality || '', suburb: b.locality || '', neighbourhood: b.locality || '', village: b.locality || '' },
        display_name: [b.locality, b.city, b.principalSubdivision, b.countryName].filter(Boolean).join(', ')
      };
      return o && o.address ? { place: o, source: 'OpenStreetMap' } : fallback ? { place: fallback, source: 'BigDataCloud' } : null;
    });
  }
  function applyPlace(type, position, result) {
    var parts = result.place.address || {};
    var zone = document.getElementById('input-' + type + '-zone');
    var ward = document.getElementById('input-' + type + '-ward');
    if (!zone || !ward) throw new Error('Không tìm thấy trường tỉnh/thành hoặc phường/xã.');
    var provinceName = parts.state || parts.province || parts.region || parts.city || '';
    var zoneOption = Array.prototype.find.call(zone.options, function (option) {
      return option.value && normalize(option.textContent) === normalize(provinceName);
    });
    if (!zoneOption) throw new Error('Chưa khớp được tỉnh/thành từ GPS. Vui lòng chọn thủ công.');
    zone.value = zoneOption.value;
    zone.dispatchEvent(new Event('change', { bubbles: true }));
    status(type, 'Đã nhận diện tỉnh/thành; đang tải phường/xã…');
    return waitForWards(ward, 10000).then(function () {
      var wardNames = [parts.suburb, parts.city_district, parts.quarter, parts.neighbourhood, parts.village, parts.town, parts.municipality, parts.hamlet].filter(Boolean);
      var wardOption = Array.prototype.find.call(ward.options, function (option) {
        return option.value && wardNames.some(function (name) {
          var wanted = normalize(name), actual = normalize(option.textContent);
          return wanted === actual || (wanted.length > 3 && actual.indexOf(wanted) !== -1) || (actual.length > 3 && wanted.indexOf(actual) !== -1);
        });
      });
      if (wardOption) {
        ward.value = wardOption.value;
        ward.dispatchEvent(new Event('change', { bubbles: true }));
      }
      var detail = document.getElementById('input-' + type + '-address-1');
      var hamlet = document.getElementById('input-' + type + '-hamlet');
      var street = [parts.house_number, parts.road || parts.pedestrian || parts.residential].filter(Boolean).join(' ');
      if (detail && !detail.value && street) detail.value = street;
      if (hamlet) {
        var locality = parts.neighbourhood || parts.quarter || parts.hamlet || '';
        var localityMatchesWard = wardOption && normalize(locality) === normalize(wardOption.textContent);
        var localityMatchesProvince = normalize(locality) === normalize(zoneOption.textContent);
        if (localityMatchesWard || localityMatchesProvince) locality = '';
        if (!hamlet.value && locality) {
          hamlet.value = locality;
          hamlet.dataset.pdGpsFilled = '1';
        } else if ((localityMatchesWard || localityMatchesProvince) && (
          hamlet.dataset.pdGpsFilled === '1' ||
          (wardOption && normalize(hamlet.value) === normalize(wardOption.textContent)) ||
          normalize(hamlet.value) === normalize(zoneOption.textContent)
        )) {
          hamlet.value = '';
          delete hamlet.dataset.pdGpsFilled;
        }
      }
      var card = document.querySelector('[data-pd-location="' + type + '"]');
      if (card) {
        card.querySelector('[data-location-title]').textContent = street || (wardOption ? wardOption.textContent : zoneOption.textContent);
        card.querySelector('[data-location-description]').textContent = result.place.display_name || [wardOption && wardOption.textContent, zoneOption.textContent].filter(Boolean).join(', ');
      }
      status(type, wardOption ? 'Đã nhận diện địa chỉ gần vị trí (sai số khoảng ' + Math.round(position.coords.accuracy) + ' m, nguồn ' + result.source + '). Hãy kiểm tra lại.' : 'Đã nhận diện tỉnh/thành; vui lòng chọn phường/xã thủ công.', wardOption ? 'success' : 'error');
      if (type === 'payment' && document.getElementById('input-address-match') && document.getElementById('input-address-match').checked) {
        var shippingZone = document.getElementById('input-shipping-zone');
        if (shippingZone) { shippingZone.value = zone.value; shippingZone.dispatchEvent(new Event('change', { bubbles: true })); }
      }
    });
  }
  function locate(type) {
    var button = document.querySelector('[data-location-start="' + type + '"]');
    if (!navigator.geolocation) { status(type, 'Trình duyệt không hỗ trợ định vị. Bạn có thể chọn địa chỉ thủ công.', 'error'); return; }
    button.disabled = true;
    button.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2" aria-hidden="true"></i>Đang lấy vị trí…';
    status(type, 'Đang xin quyền vị trí…');
    navigator.geolocation.getCurrentPosition(function (position) {
      status(type, 'Đang nhận diện khu vực GPS…');
      getGeocode(position).then(function (result) {
        if (!result) throw new Error('Không lấy được địa chỉ bản đồ. Vui lòng chọn địa chỉ thủ công.');
        return applyPlace(type, position, result);
      }).catch(function (error) { status(type, error.message || 'Không lấy được địa chỉ GPS. Vui lòng chọn thủ công.', 'error'); })
        .finally(function () { button.disabled = false; button.innerHTML = '<i class="fa-solid fa-location-arrow me-2" aria-hidden="true"></i>Sử dụng vị trí hiện tại'; });
    }, function (error) {
      status(type, error.code === 1 ? 'Bạn chưa cấp quyền vị trí. Hãy cho phép định vị hoặc chọn địa chỉ thủ công.' : 'Không lấy được vị trí hiện tại. Hãy thử lại hoặc chọn địa chỉ thủ công.', 'error');
      button.disabled = false;
      button.innerHTML = '<i class="fa-solid fa-location-arrow me-2" aria-hidden="true"></i>Sử dụng vị trí hiện tại';
    }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 60000 });
  }
  document.querySelectorAll('[data-location-start]').forEach(function (button) {
    button.addEventListener('click', function () {
      activeType = button.getAttribute('data-location-start');
      opener = button;
      consent.hidden = false;
      consentDialog.focus();
    });
  });
  consent.querySelectorAll('[data-location-dismiss]').forEach(function (button) {
    button.addEventListener('click', function () { consent.hidden = true; if (opener) opener.focus(); });
  });
  document.getElementById('pd-checkout-location-continue').addEventListener('click', function () {
    consent.hidden = true;
    if (opener) opener.focus();
    locate(activeType);
  });
  document.addEventListener('keydown', function (event) {
    if (!consent.hidden && event.key === 'Escape') { consent.hidden = true; if (opener) opener.focus(); }
  });
})(document, window);
</script>
