      phone.classList.add('is-invalid');
      var error = document.getElementById('error-telephone');
      if (error) { error.textContent = 'Vui lòng nhập số điện thoại Việt Nam gồm 10 chữ số.'; error.classList.add('d-block'); }
      phone.focus();
