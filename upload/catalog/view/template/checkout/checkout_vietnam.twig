<script>
(function (document, window) {
  'use strict';
  var endpoint = {{ ward_url|json_encode|raw }};
  var saved = { payment: {{ payment_ward_code|default('')|json_encode|raw }}, shipping: {{ shipping_ward_code|default('')|json_encode|raw }} };
  var requests = { payment: 0, shipping: 0 };

  function load(type, preserve) {
    var zone = document.getElementById('input-' + type + '-zone');
    var ward = document.getElementById('input-' + type + '-ward');
    if (!zone || !ward) return;

    var zoneId = zone.value;
    var request = ++requests[type];
    ward.innerHTML = '<option value="">' + (zoneId ? 'Đang tải phường/xã...' : 'Chọn tỉnh/thành phố trước') + '</option>';
    ward.disabled = true;
    if (!zoneId) return;

    var url = endpoint + (endpoint.indexOf('?') === -1 ? '?' : '&') + 'zone_id=' + encodeURIComponent(zoneId);
    fetch(url, { credentials: 'same-origin', headers: { Accept: 'application/json' } })
      .then(function (response) {
        if (!response.ok) throw new Error('HTTP ' + response.status);
        return response.json();
      })
      .then(function (rows) {
        if (requests[type] !== request || zone.value !== zoneId) return;
        ward.innerHTML = '<option value="">-- Chọn phường / xã --</option>';
        (Array.isArray(rows) ? rows : []).forEach(function (item) {
          if (!item || !item.code) return;
          var selected = preserve && String(item.code) === String(saved[type] || '');
          ward.add(new Option(item.full_name || item.name || item.code, item.code, false, selected));
        });
        ward.disabled = ward.options.length < 2;
        if (ward.value) ward.dispatchEvent(new Event('change', { bubbles: true }));
        if (ward.disabled) ward.options[0].textContent = 'Chưa có phường/xã cho tỉnh này';
      })
      .catch(function (error) {
        if (requests[type] !== request) return;
        ward.innerHTML = '<option value="">Không tải được phường/xã. Thử chọn lại tỉnh.</option>';
        ward.disabled = true;
        console.error('[PanDaShop] Không tải được phường/xã:', error);
      });
  }

  function bind(type) {
    var zone = document.getElementById('input-' + type + '-zone');
    if (!zone || zone.dataset.pandaWardBound === '1') return;
    zone.dataset.pandaWardBound = '1';
    document.addEventListener('change', function (event) {
      if (event.target === zone) load(type, false);
    }, true);
    zone.addEventListener('focusout', function () { if (zone.value) load(type, false); });
    if (zone.value) load(type, true);
  }

  function addAddressSearch(select) {
    if (!select || select.dataset.pandaSearchReady === '1') return;
    select.dataset.pandaSearchReady = '1';
    var wrapper = document.createElement('div');
    wrapper.className = 'pd-address-combobox';
    var input = document.createElement('input');
    input.type = 'search';
    input.id = select.id + '-search';
    input.className = 'form-control pd-address-combobox-input';
    input.autocomplete = 'off';
    input.setAttribute('role', 'combobox');
    input.setAttribute('aria-autocomplete', 'list');
    input.setAttribute('aria-expanded', 'false');
    var isSavedAddressPicker = /-(payment|shipping)-address$/.test(select.id);
    input.placeholder = isSavedAddressPicker ? 'Chọn địa chỉ giao hàng đã lưu...' : (select.id.indexOf('-zone') !== -1 ? 'Chọn hoặc gõ tỉnh/thành phố...' : 'Chọn hoặc gõ phường/xã...');
    var menu = document.createElement('div');
    menu.className = 'pd-address-combobox-menu';
    menu.id = select.id + '-options';
    menu.setAttribute('role', 'listbox');
    menu.hidden = true;
    input.setAttribute('aria-controls', menu.id);
    var parent = select.parentNode;
    parent.insertBefore(wrapper, select);
    wrapper.appendChild(input);
    wrapper.appendChild(menu);
    wrapper.appendChild(select);
    select.classList.add('pd-address-native-select');
    select.required = false;
    select.tabIndex = -1;
    select.setAttribute('aria-hidden', 'true');
    var label = parent.querySelector('label[for="' + select.id + '"]');
    if (label) label.htmlFor = input.id;

    function normalize(value) {
      return String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
    }
    function close() {
      menu.hidden = true;
      input.setAttribute('aria-expanded', 'false');
    }
    function render(query) {
      var needle = normalize(query);
      menu.replaceChildren();
      Array.prototype.forEach.call(select.options, function (option, index) {
        if (index === 0 || option.disabled) return;
        if (needle && normalize(option.textContent).indexOf(needle) === -1) return;
        if (isSavedAddressPicker) {
          var row = document.createElement('div');
          row.className = 'pd-saved-address-option';
          var choose = document.createElement('button');
          choose.type = 'button';
          choose.className = 'pd-saved-address-option__choose';
          choose.textContent = option.textContent;
          choose.setAttribute('aria-selected', option.selected ? 'true' : 'false');
          choose.addEventListener('click', function () {
            select.value = option.value;
            input.value = option.textContent;
            select.dispatchEvent(new Event('change', { bubbles: true }));
            close();
          });
          var remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'pd-saved-address-option__remove';
          remove.textContent = '×';
          remove.setAttribute('aria-label', 'Xóa địa chỉ này');
          var isDefault = option.dataset.default === '1';
          remove.disabled = isDefault;
          if (isDefault) remove.title = 'Không thể xóa địa chỉ mặc định.';
          remove.addEventListener('click', function () {
            if (isDefault) return;
            select.value = option.value;
            select.dispatchEvent(new Event('change', { bubbles: true }));
            close();
            var deleteButton = document.querySelector('[data-pd-address-delete="' + (select.id.indexOf('payment') !== -1 ? 'payment' : 'shipping') + '"]');
            if (deleteButton) deleteButton.click();
          });
          row.appendChild(choose);
          row.appendChild(remove);
          menu.appendChild(row);
          return;
        }
        var item = document.createElement('button');
        item.type = 'button';
        item.className = 'pd-address-combobox-option';
        item.setAttribute('role', 'option');
        item.textContent = option.textContent;
        item.setAttribute('aria-selected', option.selected ? 'true' : 'false');
        item.addEventListener('click', function () {
          select.value = option.value;
          input.value = option.textContent;
          select.dispatchEvent(new Event('change', { bubbles: true }));
          close();
        });
        menu.appendChild(item);
      });
      if (!menu.children.length) {
        var empty = document.createElement('div');
        empty.className = 'pd-address-combobox-empty';
        empty.textContent = select.disabled ? 'Vui lòng chọn tỉnh/thành phố trước.' : 'Không tìm thấy địa danh phù hợp.';
        menu.appendChild(empty);
      }
      menu.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    }
    function sync() {
      var option = select.options[select.selectedIndex];
      input.value = option && option.value ? option.textContent : '';
      input.disabled = select.disabled;
      if (!menu.hidden) render(input.value);
    }
    input.addEventListener('focus', function () { render(''); });
    input.addEventListener('click', function () { if (menu.hidden) render(''); });
    input.addEventListener('input', function () { render(input.value); });
    input.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') { close(); return; }
      if (event.key === 'Enter') {
        var first = menu.querySelector(isSavedAddressPicker ? '.pd-saved-address-option__choose' : '.pd-address-combobox-option');
        if (first && !menu.hidden) { event.preventDefault(); first.click(); }
      }
      if (event.key === 'ArrowDown' && menu.hidden) { event.preventDefault(); render(''); }
    });
    select.addEventListener('change', sync);
    if (window.MutationObserver) new MutationObserver(sync).observe(select, { childList: true });
    document.addEventListener('click', function (event) { if (!wrapper.contains(event.target)) close(); });
    sync();
  }
  function init() {
    bind('payment'); bind('shipping');
    ['payment', 'shipping'].forEach(function (type) {
      addAddressSearch(document.getElementById('input-' + type + '-address'));
      addAddressSearch(document.getElementById('input-' + type + '-zone'));
      addAddressSearch(document.getElementById('input-' + type + '-ward'));
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})(document, window);
