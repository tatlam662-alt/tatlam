{{ header }}
<main id="information-order-lookup" class="container pd-standard-page">
  <nav aria-label="breadcrumb"><ol class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      {% if loop.last %}<li class="breadcrumb-item active" aria-current="page">{{ breadcrumb.text }}</li>{% else %}<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endif %}
    {% endfor %}
  </ol></nav>
  <div class="row">
    {{ column_left }}
    <section id="content" class="col">
      <h1>{{ heading_title }}</h1>
      <p>{{ text_intro }}</p>
      <form method="post" action="{{ action }}" class="card p-3 p-md-4 mb-4" novalidate>
        <div class="mb-3">
          <label class="form-label" for="input-order-id">{{ entry_order_id }}</label>
          <input id="input-order-id" class="form-control" type="text" name="order_id" inputmode="numeric" pattern="[0-9]+" value="{{ order_id }}" required autocomplete="off">
        </div>
        <div class="mb-3">
          <label class="form-label" for="input-order-email">{{ entry_email }}</label>
          <input id="input-order-email" class="form-control" type="email" name="email" value="{{ email }}" required autocomplete="email" maxlength="254">
        </div>
        {% if error_lookup %}<div class="alert alert-danger" role="alert">{{ error_lookup }}</div>{% endif %}
        {% if error_rate_limit %}<div class="alert alert-warning" role="alert">{{ error_rate_limit }}</div>{% endif %}
        <p class="small text-body-secondary">{{ text_privacy }}</p>
        <button type="submit" class="btn btn-primary">{{ button_lookup }}</button>
      </form>
      {% if order %}
        <section class="card p-3 p-md-4" aria-live="polite">
          <h2>{{ heading_title }} #{{ order.id }}</h2>
          <p><strong>{{ entry_order_id }}:</strong> #{{ order.id }}</p>
          <p><strong>{{ text_date_ordered }}:</strong> {{ order.date_added }}</p>
          <p class="mb-0"><strong>{{ text_order_status }}:</strong> {{ order.status }}</p>
        </section>
      {% endif %}
      {{ content_bottom }}
    </section>
    {{ column_right }}
  </div>
</main>
{{ footer }}
