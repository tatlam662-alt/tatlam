{{ header }}
<main id="information-guides" class="container pd-standard-page">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <header class="pd-guides-header">
    <span><i class="fa-solid fa-compass" aria-hidden="true"></i></span>
    <div><h1>{{ heading_title }}</h1><p>{{ intro }}</p></div>
  </header>
  <div class="pd-guides-grid">
    {% for section in sections %}
      <section class="pd-guides-card">
        <h2>{{ section.title }}</h2>
        <ol>{% for item in section.items %}<li>{{ item }}</li>{% endfor %}</ol>
      </section>
    {% endfor %}
  </div>
  <nav class="pd-guides-policy-links" aria-label="{{ heading_title }}">
    <a href="{{ order_history }}"><i class="fa-solid fa-box-archive" aria-hidden="true"></i>{{ text_order_history_link }}</a>
    <a href="{{ shipping_policy }}"><i class="fa-solid fa-truck-fast" aria-hidden="true"></i>{{ text_shipping_link }}</a>
    <a href="{{ returns_policy }}"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i>{{ text_returns_link }}</a>
    <a href="{{ warranty_policy }}"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>{{ text_warranty_link }}</a>
    <a href="{{ contact }}"><i class="fa-solid fa-headset" aria-hidden="true"></i>{{ text_contact_link }}</a>
  </nav>
</main>
{{ footer }}
