{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid"><div class="float-end"><button type="submit" form="form-vietqr" class="btn btn-primary" title="{{ button_save }}"><i class="fa-solid fa-save"></i></button><a href="{{ back|escape }}" class="btn btn-light" title="{{ button_back }}"><i class="fa-solid fa-reply"></i></a></div><h1>{{ heading_title }}</h1><ol class="breadcrumb"><li class="breadcrumb-item"><a href="index.php?route=common/dashboard&amp;user_token={{ user_token|escape }}">{{ text_home }}</a></li><li class="breadcrumb-item">{{ heading_title }}</li></ol></div></div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}
    <form id="form-vietqr" action="{{ action|escape }}" method="post"><div class="card"><div class="card-header"><i class="fa-solid fa-qrcode"></i> {{ heading_title }}</div><div class="card-body">
      {% for field in fields %}<div class="row mb-3"><label class="col-sm-3 col-form-label">{{ field.label }}</label><div class="col-sm-9">
        {% if field.type == 'toggle' %}<select name="payment_vietqr_{{ field.name }}" class="form-select"><option value="1"{% if field.value %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not field.value %} selected{% endif %}>{{ text_disabled }}</option></select>
        {% elseif field.type == 'secret' %}<input class="form-control" type="password" name="payment_vietqr_{{ field.name }}" autocomplete="new-password" value="" placeholder="{% if secret_configured %}{{ text_keep_secret }}{% endif %}">
        {% else %}<input class="form-control" name="payment_vietqr_{{ field.name }}" type="{{ field.type == 'number' ? 'number' : 'text' }}"{% if field.type == 'number' %} min="0"{% endif %} value="{{ field.value|escape }}">
        {% endif %}
      </div></div>{% endfor %}
    </div></div></form>
  </div>
</div>{{ footer }}
